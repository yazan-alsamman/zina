---
/**
 * SITE HEADER — Phase 11: minimal, expensive, and still JavaScript-free.
 *
 * Desktop (1024+): tracked serif wordmark · five editorial links · the Collaborate pill · language.
 * Below 1024: wordmark and a two-line "Menu" trigger that opens a FULLSCREEN wine overlay with
 * large serif navigation, a small arched portrait of Zina, the CTA and the language switcher.
 *
 * NO JAVASCRIPT. The menu is still a checkbox-driven disclosure — it works with scripting
 * unavailable, which is the exact condition of a slow mobile connection. While it is open,
 * `:has()` locks page scroll behind it.
 *
 * NAVIGATION EXPOSES ONLY WHAT EXISTS: items are filtered against IMPLEMENTED_ROUTES exactly as
 * before, so a link can never lead into an unbuilt page.
 */
import type { Locale } from "../../../content/schema/types";
import { navigation } from "../../lib/content";
import { isImplemented, path, siteName } from "../../lib/routing";
import { t } from "../../lib/ui-strings";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import EditorialImage from "../beauty/EditorialImage.astro";

interface Props {
  locale: Locale;
  switcherHref: string;
  switcherState?: "counterpart" | "section-fallback" | "home-fallback";
}

const { locale, switcherHref, switcherState } = Astro.props;
const nav = navigation();

const routeKeyFor: Record<string, string> = {
  reviews: "reviewsIndex",
  method: "method",
  journal: "journalIndex",
  work: "workIndex",
  about: "about",
};

const hrefFor: Record<string, (l: Locale) => string> = {
  reviews: path.reviewsIndex,
  method: path.method,
  journal: path.journalIndex,
  work: path.workIndex,
  about: path.about,
};

const items = nav.primary
  .filter((item) => isImplemented(routeKeyFor[item.key] ?? item.key))
  .map((item) => ({
    key: item.key,
    label: item.label[locale],
    href: (hrefFor[item.key] ?? path.home)(locale),
  }));

const showCta = isImplemented("contact");
const ctaLabel = nav.cta.label[locale];
const ctaHref = path.contact(locale);
const currentPath = Astro.url.pathname;
/** "page" for the exact page, "true" for a page inside that section (WAI-ARIA 1.2). */
const currentState = (href: string): "page" | "true" | undefined =>
  currentPath === href ? "page" : href !== path.home(locale) && currentPath.startsWith(href) ? "true" : undefined;
---

<header class="site-header">
  <div class="container container--wide header-inner">
    <a class="wordmark" href={path.home(locale)}>{siteName(locale)}</a>

    {/* Checkbox-driven disclosure: no JS, no hydration, no layout shift. */}
    <input type="checkbox" id="menu-toggle" class="menu-toggle visually-hidden" />
    <label class="menu-trigger" for="menu-toggle">
      <span class="menu-trigger-open">{t(locale, "openMenu")}</span>
      <span class="menu-trigger-close">{t(locale, "closeMenu")}</span>
      <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
    </label>

    <nav class="primary-nav" aria-label={t(locale, "primaryNavigation")}>
      <div class="menu-portrait" aria-hidden="true">
        <EditorialImage
          photo="studioMonochromeProfile"
          locale={locale}
          mask="arch"
          ratio="3 / 4"
          sizes="112px"
          widths={[160, 240]}
        />
      </div>

      <ul class="nav-list plain">
        {
          items.map((item, index) => (
            <li style={`--i: ${index}`}>
              <a href={item.href} aria-current={currentState(item.href)}>
                <span class="nav-index record" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span class="nav-label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav-actions">
        {showCta && <a class="cta" href={ctaHref} aria-current={currentState(ctaHref)}>{ctaLabel}</a>}

        <div class="switcher-slot">
          <LocaleSwitcher locale={locale} href={switcherHref} state={switcherState} />
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--palette-ivory) 86%, transparent);
    backdrop-filter: saturate(1.2) blur(14px);
    -webkit-backdrop-filter: saturate(1.2) blur(14px);
    border-block-end: 1px solid color-mix(in srgb, var(--color-line-hairline) 80%, transparent);
  }

  /* The overlay must escape the header's backdrop-filter containing block. */
  .site-header:has(.menu-toggle:checked) {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  :global(html:has(#menu-toggle:checked)) {
    overflow: hidden;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--layout-header-height);
  }

  .wordmark {
    position: relative;
    z-index: calc(var(--z-overlay) + 1);
    /* At 360px the tracked Latin wordmark and the menu trigger together are wider than the
       header, and the trigger was being pushed past the edge. The wordmark is the element that
       gives way: it is allowed to shrink, and its tracking closes up, down to a floor where it
       is still recognisably the same mark. */
    font-size: calc(clamp(1.05rem, 0.72rem + 1.1vw, 1.3rem) * var(--type-arabic-size-factor));
    letter-spacing: clamp(0.16em, 0.02em + 1.4vw, var(--type-tracking-wordmark));
    text-transform: uppercase;
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
    margin-inline-end: auto;
    transition: color var(--motion-duration-base) var(--motion-easing-silk);
  }

  .wordmark:hover {
    color: var(--color-accent-clay);
  }

  /* ---------------------------------------------------------------- below 1024 */

  .menu-trigger {
    position: relative;
    z-index: calc(var(--z-overlay) + 1);
    display: inline-flex;
    align-items: center;
    gap: clamp(0.45rem, 0.1rem + 1.4vw, 0.75rem);
    flex: none;
    white-space: nowrap;
    min-block-size: 44px;
    min-inline-size: 44px;
    padding-inline: clamp(0.7rem, 0.2rem + 2vw, 1rem) clamp(0.65rem, 0.2rem + 1.8vw, 0.9rem);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    font-weight: var(--type-weight-medium);
    letter-spacing: var(--type-tracking-label);
    text-transform: uppercase;
    color: var(--color-text-primary);
    cursor: pointer;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    transition:
      color var(--motion-duration-base) var(--motion-easing-silk),
      border-color var(--motion-duration-base) var(--motion-easing-silk);
  }

  .menu-lines {
    display: grid;
    gap: 5px;
    inline-size: 18px;
  }

  .menu-lines span {
    display: block;
    block-size: 1px;
    background: currentColor;
    transition: transform var(--motion-duration-settle) var(--motion-easing-silk);
  }

  .menu-lines span:last-child {
    inline-size: 70%;
    justify-self: end;
  }

  .menu-toggle:checked + .menu-trigger .menu-lines span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-toggle:checked + .menu-trigger .menu-lines span:last-child {
    inline-size: 100%;
    transform: translateY(-3px) rotate(-45deg);
  }

  .menu-toggle:focus-visible + .menu-trigger {
    outline: var(--border-width-accent) solid var(--color-focus-ring);
    outline-offset: 3px;
  }

  .menu-trigger-close {
    display: none;
  }

  .menu-toggle:checked + .menu-trigger .menu-trigger-open {
    display: none;
  }

  .menu-toggle:checked + .menu-trigger .menu-trigger-close {
    display: inline;
  }

  /* While open, the header's own controls sit on the mocha overlay. */
  .site-header:has(.menu-toggle:checked) .wordmark,
  .menu-toggle:checked + .menu-trigger {
    color: var(--color-white);
    border-color: rgb(255 255 255 / 40%);
  }

  .primary-nav {
    display: none;
  }

  /* Fullscreen overlay on the mocha ground. Opaque — a contrast ratio over a shifting backdrop
     cannot be measured. Items sit in the lower two-thirds, within thumb reach. */
  .menu-toggle:checked ~ .primary-nav {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-5);
    padding: calc(var(--layout-header-height) + var(--space-3)) var(--layout-margin) var(--space-8);
    background: var(--gradient-wine);
    overflow-y: auto;
    animation: menu-in var(--motion-duration-settle) var(--motion-easing-silk);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  .menu-portrait {
    inline-size: 7rem;
    opacity: 0.95;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav-list a {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-block-size: 44px;
    padding-block: var(--space-1);
    color: var(--color-white);
    text-decoration: none;
    border-block-end: 1px solid rgb(255 255 255 / 12%);
  }

  .nav-index {
    font-size: var(--type-record-sm);
    color: var(--palette-beige-lifted); /* 5.08:1 on mocha */
  }

  .nav-label {
    font-family: var(--type-family-display);
    font-size: calc(clamp(2.1rem, 1.5rem + 3vw, 3rem) * var(--type-arabic-size-factor));
    line-height: 1.1;
  }

  .nav-list a:hover .nav-label,
  .nav-list a[aria-current] .nav-label {
    font-family: var(--type-family-accent);
    color: var(--palette-beige-lifted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-toggle:checked ~ .primary-nav .nav-list li {
      animation: reveal-rise var(--motion-duration-editorial) var(--motion-easing-silk) both;
      animation-delay: calc(var(--i) * var(--motion-stagger-compact) + var(--motion-stagger-sequence));
    }
  }

  .nav-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding: 0.7rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: var(--radius-control);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    font-weight: var(--type-weight-medium);
    letter-spacing: var(--type-tracking-label);
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--motion-duration-base) var(--motion-easing-silk),
      color var(--motion-duration-base) var(--motion-easing-silk),
      border-color var(--motion-duration-base) var(--motion-easing-silk);
  }

  :global(html[lang="ar"]) .cta,
  :global(html[lang="ar"]) .menu-trigger {
    text-transform: none;
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
  }

  .cta:hover {
    background: var(--color-warm-beige);
    color: var(--color-black); /* 8.74:1 */
    border-color: var(--color-warm-beige);
  }

  .switcher-slot :global(.switcher),
  .switcher-slot :global(.switcher a) {
    color: var(--color-light-grey); /* 8.50:1 on mocha */
  }

  /* ---------------------------------------------------------------- 1024 and up */

  @media (min-width: 1024px) {
    .menu-trigger,
    .menu-toggle,
    .menu-portrait {
      display: none;
    }

    .primary-nav,
    .menu-toggle:checked ~ .primary-nav {
      position: static;
      display: flex;
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
      padding: 0;
      background: none;
      animation: none;
      inset: auto;
      overflow: visible;
    }

    /* At exactly 1024 the row has no slack: five links, a pill and the switcher. The gaps are
       what give way first, closing to 0.9rem, so the language switcher is never pushed past the
       edge on a 1024-wide tablet in landscape. */
    .nav-list {
      flex-direction: row;
      gap: clamp(0.9rem, 0.1rem + 1.6vw, 2.5rem);
      margin-inline: auto;
    }

    .nav-list li {
      animation: none !important;
    }

    .nav-list a {
      position: relative;
      min-block-size: 0;
      padding-block: 0.4rem;
      border: 0;
      color: var(--color-text-secondary);
      white-space: nowrap;
    }

    .nav-index {
      display: none;
    }

    .nav-label {
      font-family: var(--type-family-ui);
      font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
      font-weight: var(--type-weight-medium);
      letter-spacing: var(--type-tracking-label);
      text-transform: uppercase;
      line-height: 1.4;
    }

    :global(html[lang="ar"]) .nav-label {
      text-transform: none;
      font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
    }

    .nav-list a:hover .nav-label,
    .nav-list a[aria-current] .nav-label {
      font-family: var(--type-family-ui);
      color: var(--color-text-primary);
    }

    /* A drawn underline, from the reading edge. */
    .nav-list a::after {
      content: "";
      position: absolute;
      inset-inline: 0;
      inset-block-end: 0;
      block-size: 2px;
      /* The active/hover navigation state IS the warm beige. It is a rule, not type, so the
         accent is free to be itself here — the label above it stays mocha for legibility. */
      background: var(--color-accent-champagne);
      transform: scaleX(0);
      transform-origin: inline-start;
      transition: transform var(--motion-duration-settle) var(--motion-easing-silk);
    }

    .nav-list a:hover::after,
    .nav-list a[aria-current]::after {
      transform: scaleX(1);
    }

    .nav-actions {
      flex-wrap: nowrap;
      gap: clamp(var(--space-2), 0.2rem + 1.4vw, var(--space-4));
    }

    .cta {
      min-block-size: 42px;
      padding: 0.6rem clamp(0.9rem, 0.2rem + 1.1vw, 1.35rem);
      border-color: var(--color-text-primary);
      color: var(--color-text-primary);
    }

    .cta:hover,
    .cta[aria-current] {
      background: var(--color-cta-fill);
      color: var(--color-cta-fg);
      border-color: var(--color-cta-fill);
    }

    .switcher-slot :global(.switcher) {
      color: var(--color-text-muted);
    }

    .switcher-slot :global(.switcher a) {
      color: var(--color-text-secondary);
    }
  }
</style>
