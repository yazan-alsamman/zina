---
/**
 * SITE FOOTER — Phase 11: the closing frame of the campaign, on the wine ground.
 *
 * The STANDARDS group still exists to be found, not hidden, and still guarantees that
 * /editorial-standards/, /brands/ and the legal pages are never orphans. The groups are filtered
 * against the same route registry as the header, and empty groups are dropped.
 *
 * The social row renders ONLY confirmed, sameAs-eligible profiles, with rel="me".
 *
 * Decoration: an oversized wordmark and one quiet floating product. Both are aria-hidden where
 * they repeat information already present.
 */
import type { Locale } from "../../../content/schema/types";
import { eligibleSocialProfiles, navigation, person } from "../../lib/content";
import { isImplemented, path, siteName } from "../../lib/routing";
import { t } from "../../lib/ui-strings";
import FloatingCosmetic from "../beauty/FloatingCosmetic.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;

const routeKeyFor: Record<string, string> = {
  "reviews.index": "reviewsIndex",
  method: "method",
  "journal.index": "journalIndex",
  "brands.index": "brandsIndex",
  "work.index": "workIndex",
  contact: "contact",
  "editorial-standards": "editorialStandards",
  privacy: "privacy",
  terms: "terms",
};

const routeFor: Record<string, (l: Locale) => string> = {
  "reviews.index": path.reviewsIndex,
  method: path.method,
  "journal.index": path.journalIndex,
  "brands.index": path.brandsIndex,
  "work.index": path.workIndex,
  contact: path.contact,
  "editorial-standards": path.editorialStandards,
  privacy: path.privacy,
  terms: path.terms,
};

const groups = navigation()
  .footer.map((group) => ({
    title: group.group[locale],
    links: group.links
      .filter((link) => isImplemented(routeKeyFor[link.routeKey] ?? link.routeKey))
      .map((link) => ({
        label: link.label[locale],
        href: (routeFor[link.routeKey] ?? path.home)(locale),
      })),
  }))
  .filter((group) => group.links.length > 0);

const personLocale = person().locales[locale];
const bio = personLocale?.bios?.homepageIntro ?? "";
const professionalTitle = personLocale?.professionalTitle ?? "";
const social = eligibleSocialProfiles();
const year = new Date().getFullYear();
---

<footer class="site-footer tone-wine">
  <span class="organic organic--glow footer-glow" aria-hidden="true"></span>
  <FloatingCosmetic kind="perfume" tint="rose" layer="mid" depth={0.4} yaw={0.4} spin={0.6} light="wine" desktopOnly class="footer-cosmetic" />
  <FloatingCosmetic kind="vial" tint="champagne" layer="back" depth={0.2} yaw={-0.5} spin={0.3} priority={-0.6} light="wine" wideOnly class="footer-cosmetic footer-cosmetic--far" />

  <div class="container container--wide">
    <div class="footer-top">
      <div class="identity">
        <p class="eyebrow">{professionalTitle}</p>
        <p class="tagline">{t(locale, "collaborateEyebrow")}</p>
        {
          isImplemented("contact") && (
            <a class="btn btn--primary footer-cta" href={path.contact(locale)}>
              <span>{t(locale, "collaborate")}</span>
              <svg class="btn-arrow" viewBox="0 0 20 10" fill="none" aria-hidden="true" focusable="false">
                <path d="M0 5h18.5M14 1l4.5 4L14 9" stroke="currentColor" stroke-width="1.1" />
              </svg>
            </a>
          )
        }
      </div>

      <nav class="groups" aria-label={t(locale, "footerNavigation")}>
        {
          groups.map((group) => (
            <div class="group">
              <h2 class="label">{group.title}</h2>
              <ul class="plain">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <p class="footer-wordmark" aria-hidden="true">{siteName(locale)}</p>

    <div class="footer-bottom">
      <p class="bio">{bio}</p>

      {
        social.length > 0 && (
          <ul class="social plain">
            {social.map((profile) => (
              <li>
                <a href={profile.url} rel="me noopener" target="_blank">
                  {profile.platform}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <p class="copyright">© {year} {siteName(locale)}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: clip;
    margin-block-start: var(--space-12);
    padding-block: var(--space-10) var(--space-5);
    border-start-start-radius: 50% 3rem;
    border-start-end-radius: 50% 3rem;
  }

  .footer-glow {
    inline-size: 42rem;
    block-size: 42rem;
    inset-block-start: -18rem;
    inset-inline-start: 30%;
    opacity: 0.35;
  }

  /* Sits in the quiet space between the identity column and the link groups. */
  .footer-cosmetic {
    inline-size: 11rem;
    inset-block-start: 7rem;
    inset-inline-start: 34%;
  }

  /* Far upstage, small and low-priority — it only ever appears when the budget has room. */
  .footer-cosmetic--far {
    inline-size: 7.5rem;
    inset-block-start: auto;
    inset-block-end: 26%;
    inset-inline-start: auto;
    inset-inline-end: 8%;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .footer-top {
    display: grid;
    gap: var(--space-8);
  }

  .tagline {
    margin-block-start: var(--space-3);
    max-width: 12ch;
    font-family: var(--type-family-display);
    font-size: calc(var(--type-display-md) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-md) * var(--type-arabic-leading-factor));
    color: var(--color-text-primary);
  }

  .footer-cta {
    margin-block-start: var(--space-5);
  }

  .groups {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }

  .group h2 {
    margin-block-end: var(--space-2);
    color: var(--color-text-muted);
  }

  .group ul {
    display: grid;
    gap: 0.35rem;
  }

  /* A navigation link is a TARGET, not a run of text: 28px tall, which clears the 24×24 CSS
     pixel minimum (WCAG 2.5.8) with room for a fingertip that lands slightly off. */
  .group a {
    display: inline-flex;
    align-items: center;
    min-block-size: 28px;
    padding-block: 0.15rem;
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-ui-md) * var(--type-arabic-size-factor));
    color: var(--color-text-secondary);
    text-decoration: none;
    /* The underline is drawn from the reading edge on hover rather than switched on. */
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition:
      background-size var(--motion-duration-settle) var(--motion-easing-silk),
      color var(--motion-duration-micro) var(--motion-easing-attend);
  }

  .group a:hover {
    color: var(--color-text-primary);
    background-size: 100% 1px;
  }

  .footer-wordmark {
    margin-block-start: var(--space-10);
    font-family: var(--type-family-display);
    font-size: calc(clamp(2.6rem, 0.8rem + 8.6vw, 10.5rem) * var(--type-arabic-size-factor));
    line-height: 0.9;
    letter-spacing: var(--type-tracking-display);
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(243 184 198 / 45%);
    user-select: none;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-3);
    border-block-start: var(--border-rule-hairline);
  }

  .bio {
    max-width: 52ch;
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-secondary);
  }

  .social a {
    display: inline-flex;
    align-items: center;
    min-block-size: 28px;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    letter-spacing: var(--type-tracking-label);
    text-transform: uppercase;
  }

  .copyright {
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .site-footer {
      border-start-start-radius: 50% 6rem;
      border-start-end-radius: 50% 6rem;
    }

    .footer-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      gap: var(--space-10);
    }

    .groups {
      padding-block-start: var(--space-8);
    }
  }
</style>
