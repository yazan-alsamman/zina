---
/**
 * SKIP LINK — first in tab order, visible on focus.
 * Two elements, no JavaScript. WCAG 2.4.1.
 */
import type { Locale } from "../../../content/schema/types";
import { t } from "../../lib/ui-strings";

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<a class="skip-link" href="#main">{t(locale, "skipToContent")}</a>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: var(--z-skip-link);
    padding: var(--space-1) var(--space-2);
    background: var(--color-ground-overlay);
    color: var(--color-text-primary);
    font-family: var(--type-family-ui);
    font-size: var(--type-ui-sm);
    text-decoration: underline;
    /* Moved out of view rather than display:none, so it stays focusable. */
    transform: translateY(-120%);
    transition: transform var(--motion-duration-instant) var(--motion-easing-standard);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
