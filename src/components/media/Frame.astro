---
/**
 * FRAME — the image primitive.
 *
 * Reserves space by ASPECT RATIO before anything loads, so a missing, slow or failed image
 * costs no layout shift. CLS is prevented structurally rather than measured and chased:
 * `width` and `height` are required fields on ImageAsset, so an image without dimensions cannot
 * exist in the content layer.
 *
 * ============================================================================
 * THE CURRENT STATE: NO PHOTOGRAPHY EXISTS
 * ============================================================================
 * The mock records point at /mock-media/... paths that were never populated. This component
 * renders the documented no-photography state rather than inventing an image:
 *
 *   - a neutral tone field at the CORRECT RATIO on ground.raised
 *   - NO icon, NO "image unavailable" glyph, NO broken-image symbol
 *   - the caption and the plate treatment are RETAINED, so the composition is real
 *   - alt text is still carried for assistive technology
 *
 * PHASE 12: the field is now MARKED as a reserved plate rather than left as an empty rectangle.
 * A hairline inset and four corner ticks — the marks a print layout carries where a photograph
 * is to be dropped in — are enough to read as "held for an image" instead of "something failed
 * to load". They assert nothing, they describe nothing, and they add no content: at a whole
 * screen's width, the difference between a reserved plate and a void is whether anyone believes
 * the page is finished.
 *
 * "An evidence plate whose caption reads 'Hour six, product lifting around the nose' is still
 * doing most of its job without the photograph."
 *
 * NO STOCK IMAGERY OF A PERSON, EVER — an honest gap rather than a borrowed face.
 *
 * When real photography arrives, `src` starts resolving and the placeholder branch stops
 * running. Swapping in astro:assets <Image> is a change to this file only.
 */
interface Props {
  src?: string | undefined;
  alt: string;
  width: number;
  height: number;
  /** True for the single LCP image on a page. Everything else is lazy. */
  priority?: boolean;
  /** Art-directed ratio override, e.g. "4 / 5" on mobile via the caller's own media query. */
  ratio?: string | undefined;
  /**
   * Shown INSIDE a reserved plate while no photograph exists. Interface vocabulary supplied by
   * the caller (which knows the locale), never content: it names the gap rather than describing
   * a picture. Omit it and the plate stays silent, as it did before.
   */
  reservedLabel?: string | undefined;
  class?: string | undefined;
}

const {
  src,
  alt,
  width,
  height,
  priority = false,
  ratio,
  reservedLabel,
  class: className = "",
} = Astro.props;

/**
 * A mock media path is a path to a file that does not exist. Treat it as absent rather than
 * emitting a broken <img>, which would produce a browser error glyph and a console 404 on
 * every review page.
 */
const isPlaceholder = !src || src.startsWith("/mock-media/");
const aspect = ratio ?? `${width} / ${height}`;
---

{
  isPlaceholder ? (
    <div
      class:list={["frame", "frame--placeholder", className]}
      style={`aspect-ratio: ${aspect};`}
      role="img"
      aria-label={alt}
    >
      {/* Inside a role="img", so it is not announced: the aria-label above already carries the
          description, and a screen-reader user is told what the plate will show. This line is
          for everyone else. */}
      {reservedLabel && <span class="frame-reserved">{reservedLabel}</span>}
    </div>
  ) : (
    <img
      class:list={["frame", className]}
      src={src}
      alt={alt}
      width={width}
      height={height}
      style={`aspect-ratio: ${aspect};`}
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "auto"}
    />
  )
}

<style>
  .frame {
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
    /* Phase 11: evidence frames take the card radius of the beauty identity. */
    border-radius: var(--radius-card);
  }

  .frame--placeholder {
    /* Still no icon, no glyph, no label — an honest gap — but a lit, tonal surface rather than a
       flat block, and never taller than a reader's screen. */
    position: relative;
    max-block-size: min(26rem, 62vh);
    background:
      radial-gradient(60% 60% at 30% 25%, rgb(255 250 247 / 80%), rgb(255 250 247 / 0%) 70%),
      linear-gradient(160deg, var(--palette-blush), var(--palette-powder));
    /* The hairline a reserved plate is ruled with. `inset 0 0 0 1px` is a border drawn as a
       shadow so it does not change the box; it is warm, like every other line on the site. */
    box-shadow: inset 0 0 0 1px rgb(122 35 66 / 12%);
  }

  /* Four corner ticks, drawn as background lines so they cost no element. Purely a registration
     mark: the placeholder is inside a role="img" with its own label, so nothing here is
     announced, and nothing here claims a photograph exists. */
  .frame-reserved {
    position: absolute;
    inset-block-end: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 1;
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    font-weight: var(--type-weight-medium);
    letter-spacing: var(--type-tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  :global(html[lang="ar"]) .frame-reserved {
    text-transform: none;
    font-weight: var(--type-weight-regular);
  }

  .frame--placeholder::after {
    content: "";
    position: absolute;
    inset: 0.75rem;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      linear-gradient(var(--palette-dusty-rose), var(--palette-dusty-rose)),
      linear-gradient(var(--palette-dusty-rose), var(--palette-dusty-rose)),
      linear-gradient(var(--palette-dusty-rose), var(--palette-dusty-rose)),
      linear-gradient(var(--palette-dusty-rose), var(--palette-dusty-rose));
    background-repeat: no-repeat;
    background-size: 14px 1px, 1px 14px, 14px 1px, 1px 14px;
    background-position: top left, top left, bottom right, bottom right;
  }

  /* Decode fade on lazy images only. Evidence images never move; a fade on load is a load
     artefact, not motion, and it is retained under reduced motion for that reason. */
  img.frame {
    animation: decode var(--motion-duration-base) var(--motion-easing-standard);
  }

  @keyframes decode {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (forced-colors: active) {
    .frame--placeholder {
      border: 1px solid CanvasText;
    }
  }
</style>
