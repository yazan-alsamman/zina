---
/**
 * REVIEW ENTRY — the index treatment. Phase 11 turns the hairline row into an editorial card.
 *
 * The card has two parts: a STAGE, where an original 3D product floats over a blush plate with the
 * category set large behind it, and the RECORD beneath. The component is still not a generic Card:
 * it exists for exactly one entity and exposes exactly the fields below.
 *
 * WHAT AN ENTRY EXPOSES:
 *   disclosure label   FIRST — a review's commercial status is part of its identity
 *   brand + category   what was tested, and from whom
 *   title / subtitle   the product, and THE TEST ("Eight hours in 38 degree heat…")
 *   conditions         at most two, where the review published them
 *   verdict seal       Zina's own words from `verdict.wouldRepurchase` — never a score
 *   dates              tested / updated
 *
 * WHAT IT MUST NEVER EXPOSE: a score, a star, a rank, a "best" label, an award, a popularity or
 * engagement figure, or any social proof.
 */
import type { Locale, Review } from "../../../content/schema/types";
import { brandById, brandPassesGate } from "../../lib/content";
import { path } from "../../lib/routing";
import { t } from "../../lib/ui-strings";
import { isolateIdentifier, isolateValue } from "../../lib/bidi";
import { formatDate } from "../../lib/format";
import { cosmeticForCategory } from "../../lib/cosmetic-kinds";
import FloatingCosmetic from "../beauty/FloatingCosmetic.astro";
import VerdictSeal from "../beauty/VerdictSeal.astro";

interface Props {
  locale: Locale;
  review: Review;
  featured?: boolean;
  /** Heading level, declared by the CALLER — a property of the document outline. */
  headingLevel?: 2 | 3;
}

const { locale, review, featured = false, headingLevel = 2 } = Astro.props;
const Heading: "h2" | "h3" = headingLevel === 3 ? "h3" : "h2";

const content = review.locales[locale]!;
const brand = brandById(review.entity.brandId);
const brandName = brand?.locales?.[locale]?.name ?? brand?.slug;
const brandLinked = brand ? brandPassesGate(brand, locale) : false;
const conditions = (content.conditions ?? []).slice(0, 2);
const cosmetic = cosmeticForCategory(review.entity.category);
const verdict = (content as { verdict?: { wouldRepurchase?: string } }).verdict;
---

<article class:list={["entry", featured && "entry--featured", "reveal"]}>
  <a class="entry-link" href={path.review(locale, content.slug!)}>
    <div class="entry-stage" aria-hidden="true">
      <span class="entry-stage-word">{review.entity.category}</span>
      <span class="entry-stage-arch"></span>
      <FloatingCosmetic kind={cosmetic.kind} tint={cosmetic.tint} depth={0.6} yaw={-0.35} class="entry-cosmetic" />
    </div>

    <div class="entry-body">
      <p class="label disclosure">{content.disclosureLabel}</p>

      <p class="identity">
        {brandName && <Fragment set:html={isolateIdentifier(brandName, locale)} />}
        <span class="sep" aria-hidden="true">·</span>
        <span>{review.entity.category}</span>
      </p>

      <Heading class="title">{content.title}</Heading>
      <p class="subtitle">{content.subtitle}</p>
    </div>
  </a>

  <div class="entry-meta">
    {
      conditions.length > 0 && (
        <dl class="conditions record">
          {conditions.map((condition) => (
            <div class="condition">
              <dt>{condition.label}</dt>
              <dd set:html={isolateValue(condition.value)} />
            </div>
          ))}
        </dl>
      )
    }

    <VerdictSeal locale={locale} value={verdict?.wouldRepurchase} compact />

    <p class="dates">
      <span>{t(locale, "tested")}</span>{" "}
      <time datetime={review.dates.testedTo} set:html={isolateValue(formatDate(review.dates.testedTo, locale))} />
      {
        review.dates.updatedAt !== review.dates.publishedAt && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <span>{t(locale, "updated")}</span>{" "}
            <time datetime={review.dates.updatedAt} set:html={isolateValue(formatDate(review.dates.updatedAt, locale))} />
          </>
        )
      }
      {!brandLinked && brandName && <span class="visually-hidden">{brandName}</span>}
    </p>
  </div>
</article>

<style>
  .entry {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    background: var(--color-ground-card);
    border: 1px solid color-mix(in srgb, var(--color-line-hairline) 90%, transparent);
    /* A card at rest is a contact shadow, so the lift on hover is something you can see. */
    box-shadow: var(--shadow-subtle);
    overflow: hidden;
    transition:
      transform var(--motion-duration-settle) var(--motion-easing-silk),
      box-shadow var(--motion-duration-settle) var(--motion-easing-silk);
  }

  @media (hover: hover) {
    .entry:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-float);
    }
  }

  /* The whole upper block is the link: one focusable element, one accessible name. */
  .entry-link {
    display: grid;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .entry-link:focus-visible {
    outline-offset: -4px;
  }

  /* ---------------------------------------------------------------- the stage */

  .entry-stage {
    position: relative;
    aspect-ratio: 5 / 3.6;
    overflow: hidden;
    background:
      radial-gradient(70% 80% at 50% 90%, rgb(235 201 200 / 90%), rgb(235 201 200 / 0%) 70%),
      linear-gradient(180deg, var(--palette-cream), var(--palette-powder));
  }

  .entry-stage-word {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 12%;
    text-align: center;
    font-family: var(--type-family-accent);
    font-size: calc(clamp(2.6rem, 2rem + 2.4vw, 4.2rem) * var(--type-arabic-size-factor));
    line-height: 1;
    color: color-mix(in srgb, var(--palette-deep-rose) 22%, transparent);
    white-space: nowrap;
  }

  /* A pale podium — the plinth of a product still life. */
  .entry-stage-arch {
    position: absolute;
    inset-inline: 24%;
    inset-block-end: 9%;
    block-size: 15%;
    border-radius: 50%;
    background: linear-gradient(180deg, #fffaf7 0%, var(--palette-petal) 100%);
    box-shadow:
      0 18px 30px -18px rgb(94 31 51 / 35%),
      inset 0 -6px 12px rgb(122 35 66 / 10%);
  }

  .entry-cosmetic {
    inline-size: var(--cosmetic-lg);
    inset-inline-start: 22%;
    inset-block-start: 4%;
  }

  /* ---------------------------------------------------------------- the record */

  .entry-body {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-3) 0;
  }

  .disclosure {
    color: var(--color-accent-clay);
  }

  .identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-secondary);
  }

  .sep {
    color: var(--color-line-strong);
  }

  .title {
    margin-block-start: var(--space-0-5);
    font-family: var(--type-family-display);
    font-size: calc(var(--type-display-sm) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-sm) * var(--type-arabic-leading-factor));
    font-weight: var(--type-weight-regular);
    color: var(--color-text-primary);
    transition: color var(--motion-duration-base) var(--motion-easing-silk);
  }

  .entry-link:hover .title {
    color: var(--color-accent-clay-hover);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .subtitle {
    max-width: 52ch;
    font-size: calc(var(--type-body-sm) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-sm) * var(--type-arabic-leading-factor));
    color: var(--color-text-secondary);
  }

  .entry-meta {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-block-start: auto;
    padding: var(--space-3);
  }

  .conditions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding-block-start: var(--space-2);
    border-block-start: var(--border-rule-hairline);
    inline-size: 100%;
  }

  .condition {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    min-width: 0;
  }

  .conditions dt {
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-muted);
  }

  .conditions dd {
    font-family: var(--type-family-record);
    font-size: var(--type-record-sm);
    color: var(--color-accent-mineral);
  }

  .conditions dd :global(bdi) {
    white-space: nowrap;
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: baseline;
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-muted);
  }

  .dates time {
    font-family: var(--type-family-record);
    font-size: var(--type-record-sm);
  }

  /* ---------------------------------------------------------------- featured */

  .entry--featured .title {
    font-size: calc(var(--type-display-md) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-md) * var(--type-arabic-leading-factor));
  }

  .entry--featured .subtitle {
    font-size: calc(var(--type-body-md) * var(--type-arabic-size-factor));
    max-width: var(--type-measure-editorial);
  }

  @media (min-width: 900px) {
    .entry--featured {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }

    .entry--featured .entry-link {
      display: contents;
    }

    .entry--featured .entry-stage {
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      min-block-size: 26rem;
    }

    .entry--featured .entry-body {
      padding: var(--space-6) var(--space-6) 0;
      align-content: start;
    }

    .entry--featured .entry-meta {
      padding: var(--space-4) var(--space-6) var(--space-6);
      align-content: end;
    }
  }
</style>
