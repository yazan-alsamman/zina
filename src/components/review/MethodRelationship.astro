---
/**
 * METHOD RELATIONSHIP — the stage markers.
 *
 * Shows which of the six stages this test ran, INCLUDING THE ONES IT DID NOT.
 *
 *   applied      filled mineral square
 *   not applied  HOLLOW square at text.muted — present, visibly not claimed
 *
 * The distinction is SHAPE, not colour, and each item's accessible name states the status in
 * words: "Comparison: not applied in this test". A review that ran four of six stages says so,
 * which is more credible than hiding the difference — and it costs nothing.
 *
 * Each stage links to its anchor on /method/. THIS IS THE MOST-REPEATED INTERNAL LINK ON THE
 * SITE: it is what turns a scattered set of reviews into a body of work with a named approach,
 * and it is the mechanism by which the Method page accumulates authority. It exists because a
 * human reads it as "which parts of the protocol did this test run", not because a crawler
 * likes it.
 *
 * ============================================================================
 * PROJECT MOCK METHOD
 * ============================================================================
 * The six stages are a PROJECT MOCK METHOD invented in Phase 0. They have NOT been verified as
 * Zina's practice. No copy in this component describes them as official, proprietary, clinical,
 * validated, certified or proven, and no seal, badge or crest appears anywhere near them.
 */
import type { Locale, MethodStageKey } from "../../../content/schema/types";
import { method } from "../../lib/content";
import { path } from "../../lib/routing";
import { t } from "../../lib/ui-strings";

interface Props {
  locale: Locale;
  appliedKeys: MethodStageKey[];
  headingId: string;
}

const { locale, appliedKeys, headingId } = Astro.props;

const record = method();
const localeBlock = record.locales[locale];
const stages = record.stageOrder.map((key) => {
  const stage = localeBlock?.stages?.find((s) => s.key === key);
  return {
    key,
    name: stage?.name ?? key,
    applied: appliedKeys.includes(key),
  };
});
---

<ul class="stages plain" aria-labelledby={headingId}>
  {
    stages.map((stage) => (
      <li class:list={["stage", stage.applied ? "stage--applied" : "stage--absent"]}>
        <a
          href={path.methodStage(locale, stage.key)}
          aria-label={`${stage.name}: ${stage.applied ? t(locale, "stageApplied") : t(locale, "stageNotApplied")}`}
        >
          <span class="marker" aria-hidden="true" />
          <span class="name">{stage.name}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .stages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .stage a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
    text-decoration: none;
    min-block-size: 44px;
    align-content: center;
  }

  .marker {
    inline-size: 6px;
    block-size: 6px;
    flex: none;
    /* The mineral square: a tick on a scale, not a bullet. The only designed mark on the site. */
  }

  /* APPLIED — filled. */
  .stage--applied a {
    color: var(--color-text-primary);
  }

  .stage--applied .marker {
    background: var(--color-accent-mineral);
  }

  /* NOT APPLIED — hollow. Shape carries the meaning, not colour. */
  .stage--absent a {
    color: var(--color-text-muted);
  }

  .stage--absent .marker {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-text-muted);
  }

  .stage a:hover {
    color: var(--color-accent-clay-hover);
    text-decoration: underline;
  }

  @media (forced-colors: active) {
    .stage--applied .marker {
      background: CanvasText;
    }

    .stage--absent .marker {
      background: transparent;
      box-shadow: inset 0 0 0 1px CanvasText;
    }
  }
</style>
