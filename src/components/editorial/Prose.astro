---
/**
 * PROSE — the long-form reading surface.
 *
 * The ONLY place in the codebase that styles bare HTML elements by tag name, and it is scoped to
 * this wrapper. MDX emits `<p>`, `<h2>`, `<ul>`, `<blockquote>`, `<table>` — native HTML, exactly
 * as it should. Turning each of those into a custom component would be inventing a vocabulary the
 * content does not need.
 *
 * Everything here is a token or a ratio. The measure is a MAXIMUM, not a fixed width, so text
 * reflows rather than truncates at 200% zoom — and it is expressed in `ch`, which scales with the
 * font, so Arabic at x1.12 gets a proportionally wider column automatically.
 *
 * RTL: logical properties throughout. There is no direction override in this file.
 */
---

<div class="prose"><slot /></div>

<style>
  .prose {
    max-width: var(--type-measure-editorial);
  }

  /* ---------------------------------------------------------------- paragraphs */

  .prose :global(p) {
    font-size: calc(var(--type-body-md) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-md) * var(--type-arabic-leading-factor));
    color: var(--color-text-primary);
  }

  .prose :global(p + p) {
    margin-block-start: var(--space-3);
  }

  /* ---------------------------------------------------------------- headings
     Generous space ABOVE, tight below: a heading belongs to what follows it. */

  .prose :global(h2) {
    margin-block: var(--space-8) var(--space-2);
    font-family: var(--type-family-display);
    font-size: calc(var(--type-display-sm) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-sm) * var(--type-arabic-leading-factor));
    font-weight: var(--type-weight-regular);
    letter-spacing: var(--type-tracking-display);
    scroll-margin-top: 6rem;
  }

  .prose :global(h3) {
    margin-block: var(--space-6) var(--space-2);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-body-lg) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-lg) * var(--type-arabic-leading-factor));
    font-weight: var(--type-weight-medium);
    scroll-margin-top: 6rem;
  }

  .prose :global(h2:first-child),
  .prose :global(h3:first-child) {
    margin-block-start: 0;
  }

  /* ---------------------------------------------------------------- lists
     Markers are the mineral square, as everywhere else in the system. Indentation uses logical
     padding so RTL mirrors without an override. */

  .prose :global(ul),
  .prose :global(ol) {
    margin-block-start: var(--space-3);
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-3);
  }

  .prose :global(li) {
    font-size: calc(var(--type-body-md) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-md) * var(--type-arabic-leading-factor));
  }

  .prose :global(ul) {
    list-style: none;
    padding-inline-start: 0;
  }

  .prose :global(ul > li) {
    position: relative;
    padding-inline-start: var(--space-2);
  }

  .prose :global(ul > li)::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    inline-size: 6px;
    block-size: 6px;
    background: var(--color-accent-mineral);
  }

  /* Ordered lists keep real numerals: the order is the meaning. */
  .prose :global(ol) {
    list-style: decimal;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(ol > li)::marker {
    color: var(--color-accent-mineral);
    font-family: var(--type-family-record);
    font-size: var(--type-record-sm);
  }

  /* ---------------------------------------------------------------- quotation
     A blockquote means "someone else said this" — the CLAIM voice. Dotted rule, recessed,
     exactly as on the review page. An authorial aside is EditorialNote, not this. */

  .prose :global(blockquote) {
    margin-block: var(--space-5);
    padding-inline-start: var(--space-3);
    border-inline-start: var(--border-rule-claim);
  }

  .prose :global(blockquote p) {
    font-size: calc(var(--type-body-sm) * var(--type-arabic-size-factor));
    color: var(--color-evidence-claim);
  }

  .prose :global(blockquote cite) {
    display: block;
    margin-block-start: var(--space-1);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    font-style: normal;
    color: var(--color-text-muted);
  }

  /* ---------------------------------------------------------------- figures */

  .prose :global(figure) {
    margin-block: var(--space-6);
  }

  .prose :global(figcaption) {
    margin-block-start: var(--space-2);
    padding-block-end: var(--space-1);
    border-block-end: var(--border-rule-hairline);
    font-size: calc(var(--type-body-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-secondary);
  }

  /* ---------------------------------------------------------------- tables
     Scroll inside their OWN container, never the page. Hairline row rules, no outer border,
     no cell borders, no zebra — the conditions-well treatment. */

  .prose :global(.table-scroll),
  .prose :global(table) {
    inline-size: 100%;
  }

  .prose :global(table) {
    margin-block: var(--space-5);
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }

  .prose :global(caption) {
    margin-block-end: var(--space-2);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-muted);
    text-align: start;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-1) var(--space-2);
    border-block-end: var(--border-rule-hairline);
    text-align: start;
    vertical-align: baseline;
    font-size: calc(var(--type-body-sm) * var(--type-arabic-size-factor));
  }

  .prose :global(th) {
    font-family: var(--type-family-ui);
    font-weight: var(--type-weight-medium);
    color: var(--color-text-muted);
  }

  /* ---------------------------------------------------------------- rules and inline */

  .prose :global(hr) {
    margin-block: var(--space-8);
    border: 0;
    border-block-start: var(--border-rule-hairline);
  }

  .prose :global(strong) {
    font-weight: var(--type-weight-medium);
  }

  /* Arabic has no italic. Emphasis is weight and colour in BOTH scripts, so the mechanism is
     shared rather than substituted — docs/TYPOGRAPHY_SYSTEM.md section 1. */
  .prose :global(em) {
    font-style: normal;
    font-weight: var(--type-weight-medium);
    color: var(--color-text-primary);
  }

  .prose :global(code) {
    font-family: var(--type-family-record);
    font-size: var(--type-record-md);
    color: var(--color-accent-mineral);
  }
</style>
