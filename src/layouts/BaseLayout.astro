---
/**
 * BASE LAYOUT — the document shell.
 *
 * Owns: <html lang dir>, head metadata, locale-split font loading, landmarks, skip link,
 * header, footer. Every page in the site renders inside it.
 *
 * The locale is a REQUIRED prop rather than something inferred, so `lang` and `dir` cannot be
 * forgotten — the two attributes that most often go missing on bilingual sites.
 */
import type { Locale } from "../../content/schema/types";
import type { PageMeta } from "../lib/seo";
import type { Alternate } from "../lib/routing";
import { localeConfig, IS_MOCK_SOURCE, IS_PREVIEW } from "../lib/content";
import { absoluteUrl } from "../lib/routing";
import { photography } from "../lib/photography";
import SiteHeader from "../components/shell/SiteHeader.astro";
import SiteFooter from "../components/shell/SiteFooter.astro";
import SkipLink from "../components/shell/SkipLink.astro";
import CosmeticScene from "../components/beauty/CosmeticScene.astro";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  locale: Locale;
  meta: PageMeta;
  alternates?: Alternate[];
  /** Serialised JSON-LD blocks. Everything marked up must be visible on the page. */
  schemas?: string[];
  /** The counterpart URL for this document, resolved by the caller. */
  switcherHref: string;
  switcherState?: "counterpart" | "section-fallback" | "home-fallback";
  /**
   * RSS autodiscovery (Phase 8). Absolute URL of this locale's journal feed. Optional and passed
   * only by journal surfaces — most pages have nothing to syndicate, and a feed link on every
   * page would be noise rather than discovery.
   */
  feedHref?: string;
  feedTitle?: string;
}

const {
  locale,
  meta,
  alternates = [],
  schemas = [],
  switcherHref,
  switcherState,
  feedHref,
  feedTitle,
} = Astro.props;
const config = localeConfig(locale);
const dir = config.dir;
const ogImage = meta.ogImage ?? absoluteUrl("/og/zina-almokri.jpg");
const ogImageAlt = photography.portraitGlow.alt[locale];
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={meta.robots} />

    {/* Locale variants NEVER canonicalise to each other. They are alternates, not duplicates —
        cross-locale canonicalisation would deindex one language entirely. */}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    {
      feedHref && (
        <link rel="alternate" type="application/rss+xml" title={feedTitle} href={feedHref} />
      )
    }

    <meta property="og:type" content={meta.ogType} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content={locale === "ar" ? "ar_AR" : "en_US"} />
    {/* Phase 11: real photography exists, so every page has a social preview. A page-specific
        image wins; otherwise the portrait card from scripts/build-og-image.mjs is used. */}
    <meta property="og:image" content={ogImage} />
    {!meta.ogImage && <meta property="og:image:width" content="1200" />}
    {!meta.ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />

    {/* Warm ivory, matching --color-ground-base in the Phase 11 palette. */}
    <meta name="theme-color" content="#FFFFFF" />

    {/*
      THE SITE MARK (Phase 13). The arch — the identity's signature portrait mask — reversed out
      in ivory on deep rose. Generated by scripts/build-favicon.mjs from one geometry, so the
      three formats cannot drift apart.

      Order is the standard recipe: the .ico is declared first with an explicit size for the
      browsers that only understand it (and for the automatic /favicon.ico request, which
      returned 404 on every page before this phase), the SVG second because a browser that
      understands it prefers the last icon it can use.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      LOCALE-SPLIT FONT LOADING. An English page never downloads an Arabic subset and vice versa.
      Measured payload: 79.2 KB (en) / 151.9 KB (ar), against a 180 KB per-locale budget.

      Generated by scripts/build-fonts.mjs as real assets rather than bundler imports, because
      the locale is a runtime value and a static import graph would attach both locales to every
      page. See docs/PERFORMANCE_IMPLEMENTATION.md.

      Zarid is NOT licensed. These are the documented open-source fallback tier, SIL OFL 1.1,
      self-hosted. No CDN, no third-party request, no tracking.

      Two faces are preloaded per locale: the one the first paint needs for display text and the
      one it needs for UI. Preloading more would compete with the LCP image for bandwidth.
    */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={
        locale === "ar"
          ? "/fonts/noto-naskh-arabic-arabic-400-normal.woff2"
          : "/fonts/cormorant-garamond-latin-500-normal.woff2"
      }
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={
        locale === "ar"
          ? "/fonts/ibm-plex-sans-arabic-arabic-400-normal.woff2"
          : "/fonts/jost-latin-400-normal.woff2"
      }
    />
    <link rel="stylesheet" href={locale === "ar" ? "/fonts/ar.css" : "/fonts/en.css"} />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" is:inline set:html={schema} />
      ))
    }
  </head>

  <body>
    <SkipLink locale={locale} />
    <SiteHeader locale={locale} switcherHref={switcherHref} switcherState={switcherState} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter locale={locale} />

    {/* Phase 11: the decorative 3D product layer. Loads Three.js lazily, and only when the page
        has product slots and the device can render WebGL. */}
    <CosmeticScene />

    {
      /*
        BUILD PROVENANCE — the mock marker that cannot be rendered away.
        =============================================================================
        A comment, never a UI element: a visible "mock" badge would imply mock content can
        ship, and it cannot.

        The literal __MOCK_DATA__ is deliberate. It is one of the seven signatures
        tools/check-mock-guard.mjs scans for, so ANY build from the mock layer fails the guard
        REGARDLESS OF WHAT THE COMPONENTS HAPPEN TO RENDER.

        Without this, the guarantee would depend on mock content containing something
        conspicuous — an example.com URL, a /mock-media/ path. It would then quietly disappear
        the day someone gave a mock brand a realistic URL. Phase 4 brief section 30: mock
        markers must not vanish merely because a component does not render them.
      */
      IS_MOCK_SOURCE && (
        <Fragment
          set:html={`<!-- __MOCK_DATA__ CONTENT SOURCE: DEVELOPMENT MOCK. NOT FOR PRODUCTION. See docs/CONTENT_IMPLEMENTATION.md -->`}
        />
      )
    }
    {IS_PREVIEW && <Fragment set:html={`<!-- PREVIEW BUILD: noindex site-wide -->`} />}
  </body>
</html>
