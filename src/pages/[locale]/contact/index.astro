---
/**
 * CONTACT — /{locale}/contact/
 *
 * ============================================================================
 * THERE IS NO FORM ON THIS PAGE, AND THAT IS THE POINT
 * ============================================================================
 * A contact form is a promise: "type here and it reaches a person." Honouring that promise needs
 * a destination — a mail handler, an endpoint, an inbox. This project has no backend, by explicit
 * architectural decision, and none is planned for this phase.
 *
 * A form without a destination is the worst available option. It looks functional, it accepts a
 * message someone took time to write, and then it silently discards it. The reader believes they
 * have made contact; they have not. Every alternative dishonesty is smaller than that one:
 *
 *   a disabled form      still advertises a channel and invites a retry
 *   a "coming soon" form is a form that does not work, with an excuse attached
 *   a mailto: form       requires an address, and no address is verified (below)
 *
 * So the page carries no `<form>`, no inputs, no submit control and no fake success state. When a
 * real endpoint exists, that is the first genuinely justified place in this project to introduce
 * client JavaScript — and only if progressive enhancement cannot carry it.
 *
 * ============================================================================
 * CONTACT CHANNELS — updated Phase 9
 * ============================================================================
 * The project owner supplied three verified channels, now CONFIRMED in `content/mock/site.json`
 * and `content/mock/social-profiles.json`: a general email, a phone number, and Zina's official
 * Instagram. `collaborationEmail` and `pressEmail` remain MOCK (`@zinaalmokri.example.com`) —
 * only the channels actually supplied render; the other two stay exactly as absent as before.
 *
 * `contactChannels()`, `verifiedPhone()` and `officialInstagram()` each independently gate on
 * `_verification === "CONFIRMED"` / `sameAsEligible === true`. Nothing here decides what counts
 * as verified — that gate lives in `src/lib/trust.ts`, unchanged since Phase 7. The page renders
 * whatever it is handed and nothing else; the "no channel published" band that used to render
 * unconditionally now shows only if every channel is ever un-confirmed again.
 *
 * The phone number is rendered exactly as supplied ("0989 000 009") in the visible text; the
 * `tel:` href is a digits-only normalisation of that same value (`telHref()`), because a `tel:`
 * URI containing spaces is not a working link on most platforms. Display and href always derive
 * from the one stored value — there is no second, independently-typed phone number anywhere.
 */
import type { GetStaticPaths } from "astro";
import type { Locale } from "../../../../content/schema/types";
import { LOCALES, IS_INDEXABLE_BUILD, person } from "../../../lib/content";
import { contactChannels, hasAnyContactChannel, management, officialInstagram, telHref, verifiedPhone } from "../../../lib/trust";
import { absoluteUrl, path, robotsContent, sectionBreadcrumb } from "../../../lib/routing";
import { breadcrumbSchema, jsonLd, personSchema, templatedMeta } from "../../../lib/seo";
import { t } from "../../../lib/ui-strings";
import { isolateValue } from "../../../lib/bidi";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/shell/Breadcrumbs.astro";
import PageHero from "../../../components/beauty/PageHero.astro";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };

/** The general email channel, when confirmed. Collaboration/press remain unconfirmed and absent. */
const channels = contactChannels();
const phone = verifiedPhone();
const instagram = officialInstagram();
const agency = management();

const selfPath = path.contact(locale);
const alternates = [
  ...LOCALES.map((l) => ({ hreflang: l, href: absoluteUrl(path.contact(l)) })),
  { hreflang: "x-default", href: absoluteUrl(path.contact("en")) },
];

const meta = templatedMeta(t(locale, "collaborate"), t(locale, "contactIntro"), {
  canonical: absoluteUrl(selfPath),
  robots: robotsContent(IS_INDEXABLE_BUILD),
  locale,
});

const crumbs = sectionBreadcrumb(
  locale,
  { home: t(locale, "home"), section: t(locale, "collaborate") },
  undefined,
  path.contact
);

/**
 * JSON-LD — BreadcrumbList, plus Person with the confirmed contact fields.
 *
 * Still no `ContactPage`/`ContactPoint` and still no `Organization`: no legal entity exists
 * (`legalIdentity().entityName` is unconfirmed), and a `ContactPoint` conventionally belongs to
 * one. Zina is modelled as a `Person` everywhere else on the site; `email`/`telephone` are
 * schema.org properties directly on `Person`, so this is the same entity every other page's
 * structured data already describes, not a new one.
 *
 * `email`/`telephone` are passed here, and ONLY here — `personSchema()` defaults to omitting
 * them, and every other caller (home, about, review, journal, work) still gets none, because
 * this is the only page where the values are also visible text (rule 4, src/lib/seo.ts). `sameAs`
 * needs no such option: it already renders wherever `personSchema()` is called, because a link to
 * an external profile does not need to be repeated as on-page text to be honest.
 */
const schemas = [
  jsonLd(breadcrumbSchema(crumbs)),
  jsonLd(
    personSchema(person(), locale, {
      ...(channels.find((c) => c.key === "general") ? { email: channels.find((c) => c.key === "general")!.address } : {}),
      ...(phone ? { telephone: phone } : {}),
    })
  ),
];

const collaborationBio = person().locales[locale]?.bios?.collaboration ?? "";
const hasAnyChannel = hasAnyContactChannel();
---

<BaseLayout
  locale={locale}
  meta={meta}
  alternates={alternates}
  schemas={schemas}
  switcherHref={path.contact(locale === "en" ? "ar" : "en")}
>
  <PageHero locale={locale} photo="portraitGoldenHour" tone="champagne" cosmetics={[{ kind: "perfume", tint: "rose" }, { kind: "gloss", tint: "blush" }]}>
    <Breadcrumbs locale={locale} crumbs={crumbs} />

    <p class="eyebrow">{t(locale, "collaborateEyebrow")}</p>
    <h1 class="display-lg title">{t(locale, "collaborate")}</h1>
    <p class="intro text-column">{t(locale, "contactIntro")}</p>
  </PageHero>

  <div class="container contact">

    {collaborationBio && <p class="collaboration text-column">{collaborationBio}</p>}

    {
      hasAnyChannel ? (
        <section class="channels" aria-labelledby="channels">
          <h2 class="section-heading" id="channels">{t(locale, "contactChannelsHeading")}</h2>
          <dl class="channel-list">
            {channels.map((channel) => (
              <div class="channel">
                <dt class="label">
                  {channel.key === "general" && t(locale, "contactGeneral")}
                  {channel.key === "collaboration" && t(locale, "contactCollaboration")}
                  {channel.key === "press" && t(locale, "contactPress")}
                </dt>
                <dd>
                  <a href={`mailto:${channel.address}`}>{channel.address}</a>
                </dd>
              </div>
            ))}
            {phone && (
              <div class="channel">
                <dt class="label">{t(locale, "contactPhone")}</dt>
                <dd>
                  <a href={telHref(phone)} set:html={isolateValue(phone)} />
                </dd>
              </div>
            )}
            {instagram && (
              <div class="channel">
                <dt class="label">{t(locale, "contactInstagram")}</dt>
                <dd>
                  {/* rel="me" — IndieWeb identity verification: this asserts "this external
                      profile and this page are the same entity", which is the opposite claim
                      nofollow makes ("I do not vouch for this"). It is the correct relation for a
                      confirmed sameAs link and is never used on a brand's own site. Matches the
                      footer's own social row exactly (src/components/shell/SiteFooter.astro). */}
                  <a href={instagram.url} rel="me noopener" target="_blank">@{instagram.handle}</a>
                </dd>
              </div>
            )}
          </dl>
        </section>
      ) : (
        /*
          THE ABSENCE, STATED PLAINLY.

          Same band treatment as the review disclosure and the brand relationship: a statement
          about the limits of what this site can currently do. Never small print, never a
          <details>, never omitted — an omitted contact section reads as an oversight, and this
          is a decision.
        */
        <section class="unavailable" aria-labelledby="unavailable">
          <h2 class="label unavailable-label" id="unavailable">
            {t(locale, "contactUnavailableHeading")}
          </h2>
          <p class="unavailable-statement">{t(locale, "contactUnavailableBody")}</p>
        </section>
      )
    }

    {
      agency && (
        <section class="agency" aria-labelledby="agency">
          <h2 class="section-heading" id="agency">{t(locale, "contactManagement")}</h2>
          <p>
            <span>{agency.agencyName}</span>
            <a href={`mailto:${agency.agencyEmail}`}>{agency.agencyEmail}</a>
          </p>
        </section>
      )
    }

    {/* Where a reader can go instead — real destinations, not consolation. */}
    <section class="elsewhere" aria-labelledby="elsewhere">
      <h2 class="section-heading" id="elsewhere">{t(locale, "contactElsewhereHeading")}</h2>
      <ul class="elsewhere-list plain">
        <li>
          <a href={path.editorialStandards(locale)}>{t(locale, "editorialStandards")}</a>
          <span class="note">{t(locale, "contactElsewhereStandards")}</span>
        </li>
        <li>
          <a href={path.method(locale)}>{t(locale, "method")}</a>
          <span class="note">{t(locale, "contactElsewhereMethod")}</span>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .contact {
    padding-block: var(--space-6) var(--space-8);
  }

  .eyebrow {
    margin-block-start: var(--space-5);
  }

  .intro {
    margin-block: var(--space-3) 0;
    color: var(--color-text-secondary);
    font-size: var(--type-body-lg);
  }

  .collaboration {
    margin-block: 0 var(--space-4);
  }

  .unavailable {
    margin-block: var(--space-5);
    padding: var(--space-3);
    border-inline-start: var(--border-rule-verdict);
    background: var(--color-ground-raised);
  }

  .unavailable-label {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
  }

  .unavailable-statement {
    margin: 0;
    max-width: var(--type-measure-editorial);
  }

  .channels,
  .agency,
  .elsewhere {
    margin-block-start: var(--space-6);
  }

  .section-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--type-family-display);
    font-size: var(--type-display-sm);
    line-height: var(--type-leading-display-sm);
    font-weight: var(--type-weight-regular);
  }

  .channel-list {
    display: grid;
    gap: var(--space-3);
  }

  /* Each channel is a soft card with the address set large — the page's primary action. */
  .channel {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-ground-card);
    border: 1px solid var(--color-line-hairline);
    box-shadow: var(--shadow-soft);
  }

  .channel dd a {
    font-family: var(--type-family-display);
    font-size: calc(var(--type-display-sm) * var(--type-arabic-size-factor));
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  @media (min-width: 900px) {
    .channel-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .channel dt {
    flex: 0 0 auto;
    min-inline-size: 8rem;
    color: var(--color-text-muted);
  }

  .channel dd {
    margin: 0;
  }

  .elsewhere-list li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    padding-block: var(--space-2);
    border-block-start: var(--border-rule-hairline);
  }

  .note {
    color: var(--color-text-muted);
  }
</style>
