---
/**
 * BRAND FACET — /{locale}/reviews/brand/{slug}/
 *
 * PERMANENTLY noindex, follow + canonical -> /{locale}/reviews/.
 *
 * WHY IT EXISTS AT ALL: a review whose brand fails the per-locale index gate links to "reviews of
 * this brand" instead of to a brand page that does not exist. In Phase 4 that link pointed at
 * `?brand=slug`, which in a static build silently returned the unfiltered index — a link that
 * looked like it worked and did not. This route makes it real.
 *
 * WHY IT IS NEVER INDEXABLE: the canonical brand surface is /{locale}/brands/{slug}/ when the
 * gate passes. Two indexable pages listing the same reviews for the same brand would compete
 * with each other, which is the self-inflicted cannibalisation Phase 1 designed the brand gate to
 * avoid. This one is navigation, and it says so.
 *
 * There is no /reviews/{category}/{brand}/ and there will not be. Multi-facet URLs are the
 * classic crawl-budget sink and no reader needs one at any corpus size this site will reach.
 */
import type { GetStaticPaths } from "astro";
import type { Locale } from "../../../../../content/schema/types";
import { LOCALES, brandById } from "../../../../lib/content";
import { brandDestination, brandFacet, brandFacets, facetIndexing } from "../../../../lib/facets";
import { absoluteUrl, path, sectionBreadcrumb, otherLocale } from "../../../../lib/routing";
import { breadcrumbSchema, jsonLd, templatedMeta } from "../../../../lib/seo";
import { t } from "../../../../lib/ui-strings";
import { formatCount, countedNoun } from "../../../../lib/format";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/shell/Breadcrumbs.astro";
import PageHero from "../../../../components/beauty/PageHero.astro";
import ReviewEntry from "../../../../components/review/ReviewEntry.astro";

export const getStaticPaths = (() => {
  const paths: Array<{ params: { locale: Locale; brand: string } }> = [];
  for (const locale of LOCALES) {
    for (const facet of brandFacets(locale)) {
      paths.push({ params: { locale, brand: facet.slug } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { locale, brand: brandSlug } = Astro.params as { locale: Locale; brand: string };

const facet = brandFacet(locale, brandSlug);
if (!facet) {
  throw new Error(`brand facet ${locale}/${brandSlug} was routed but has no records`);
}

const selfPath = path.reviewsByBrand(locale, facet.slug);
const indexPath = path.reviewsIndex(locale);
const indexing = facetIndexing(facet, selfPath, indexPath, "brand");

const meta = templatedMeta(facet.name, t(locale, "brandIndexIntro"), {
  canonical: absoluteUrl(indexing.canonicalPath),
  robots: indexing.robots,
  locale,
});

const crumbs = sectionBreadcrumb(
  locale,
  { home: t(locale, "home"), section: t(locale, "reviews") },
  facet.name
);

const schemas = [jsonLd(breadcrumbSchema(crumbs))];

const target = otherLocale(locale);
const switcherHref = brandFacet(target, facet.slug)
  ? path.reviewsByBrand(target, facet.slug)
  : path.reviewsIndex(target);

/*
 * Points at the brand page when one exists — gate passing AND template implemented. Today the
 * template is not built, so brandDestination() returns this very facet, and linking a page to
 * itself is pointless: the link is therefore not rendered at all.
 */
const brandRecord = brandById(facet.brandId);
const brandPageHref = (() => {
  const destination = brandDestination(brandRecord, locale);
  return destination && destination !== selfPath ? destination : undefined;
})();
---

{/* No hreflang: a noindex navigation view claims no cross-language equivalence. */}
<BaseLayout locale={locale} meta={meta} schemas={schemas} switcherHref={switcherHref}>
  <PageHero locale={locale} compact cosmetics={[{ kind: "jar", tint: "blush" }]}>
    <Breadcrumbs locale={locale} crumbs={crumbs} />

    <h1 class="display-lg title">{facet.name}</h1>

    <p class="intro text-column">{t(locale, "brandIndexIntro")}</p>

    <p class="count record">
      <span class="count-value">{formatCount(facet.count, locale)}</span>
      <span class="count-label">{countedNoun(facet.count, locale, { one: t(locale, "reviewCountOne"), other: t(locale, "reviewCount") })}</span>
      <span class="count-label">·</span>
      <span class="count-label nav-only">{t(locale, "navigationOnly")}</span>
    </p>
  </PageHero>

  <div class="container facet-page">

    <div class="entries">
      {facet.reviews.map((review) => <ReviewEntry locale={locale} review={review} />)}
    </div>

    <p class="back">
      <a href={indexPath}>{t(locale, "allReviewsLabel")}</a>
      {/* Rendered only when the brand page actually exists in this locale (risk R-14). */}
      {brandPageHref && <a href={brandPageHref}>{facet.name}</a>}
    </p>
  </div>
</BaseLayout>

<style>
  .facet-page {
    padding-block: var(--space-6) var(--space-10);
  }

  .title {
    margin-block-start: var(--space-3);
  }

  .intro {
    margin-block-start: var(--space-3);
    font-size: calc(var(--type-body-lg) * var(--type-arabic-size-factor));
    color: var(--color-text-secondary);
  }

  .count {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1);
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
  }

  .count-value {
    color: var(--color-accent-mineral);
  }

  .count-label {
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
  }

  .nav-only {
    color: var(--color-text-secondary);
  }

  .entries {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-8);
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-3);
    border-block-start: var(--border-rule-hairline);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
  }
</style>
