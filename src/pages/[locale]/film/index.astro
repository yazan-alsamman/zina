---
/**
 * THE FILM — /{locale}/film/
 *
 * ============================================================================
 * WHAT THIS PAGE IS
 * ============================================================================
 * A scroll-driven cinematic presentation of Zina's six-stage testing method: seven frames, five
 * of her photographs, one original 3D package, one continuous camera. Scroll is the transport.
 *
 * ============================================================================
 * WHAT IT IS NOT, AND WHY THAT MATTERS
 * ============================================================================
 * It is NOT a product film. Every line of type on it is either Zina's own tagline or the name of
 * a stage of her method — both real records in `content/`. It makes no claim about what any
 * product does, because that belongs to individual reviews where the conditions are published
 * alongside it. The 3D package is the site's own ORIGINAL generic packaging (see
 * src/scripts/cosmetics/models.ts); it depicts no real product and is never captioned as one.
 *
 * The boundary statement travels with the method everywhere the method appears, so it appears
 * here too — in the coda, where it can actually be read.
 *
 * ============================================================================
 * THE PAGE WITHOUT THE FILM
 * ============================================================================
 * The DOM is a storyboard, and the storyboard is the page. With no JavaScript, no WebGL,
 * Save-Data on, or reduced motion requested, a reader gets seven full-bleed frames of Zina's
 * photography with the six stages set over them — finished editorial work, not a degraded state.
 * The film is an enhancement laid over content that was already complete.
 *
 * Reduced motion refuses the film outright (src/scripts/cosmetics/boot.ts). A scroll-driven
 * camera cannot be made still without ceasing to be the thing it is, and there is no honest
 * "reduced" version of a dolly.
 */
import type { GetStaticPaths } from "astro";
import type { Locale } from "../../../../content/schema/types";
import { LOCALES, IS_INDEXABLE_BUILD, method, person } from "../../../lib/content";
import { absoluteUrl, path, robotsContent } from "../../../lib/routing";
import { jsonLd, personSchema, templatedMeta } from "../../../lib/seo";
import { t } from "../../../lib/ui-strings";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FilmStage from "../../../components/cinema/FilmStage.astro";
import { filmBeats, FILM_PRODUCT } from "../../../lib/film";
import BeautyButton from "../../../components/beauty/BeautyButton.astro";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };

const personRecord = person();
const personLocale = personRecord.locales[locale]!;
const methodRecord = method();
const methodLocale = methodRecord.locales[locale]!;

/**
 * THE SHOOTING ORDER comes from src/lib/film.ts, which the homepage's cinematic opening also
 * reads. One film, mounted twice — see that file for why it is not written out here.
 *
 * On this route the film's title card carries the page's `h1`: the film's own typography IS the
 * document outline, because there is nothing else on the page above the coda.
 */
const beats = filmBeats(locale, { heading: true });

const selfPath = path.film(locale);
const meta = templatedMeta(t(locale, "filmMetaTitle"), t(locale, "filmMetaDescription"), {
  canonical: absoluteUrl(selfPath),
  robots: robotsContent(IS_INDEXABLE_BUILD),
  locale,
});

const alternates = [
  ...LOCALES.map((l) => ({ hreflang: l, href: absoluteUrl(path.film(l)) })),
  { hreflang: "x-default", href: absoluteUrl(path.film("en")) },
];

/* Person only. No VideoObject: there is no video file, no duration and no thumbnail to declare,
   and marking a WebGL scene up as a video would be a fabricated entity. */
const schemas = [jsonLd(personSchema(personRecord, locale))];
---

<BaseLayout
  locale={locale}
  meta={meta}
  alternates={alternates}
  schemas={schemas}
  switcherHref={path.film(locale === "en" ? "ar" : "en")}
>
  <FilmStage
    locale={locale}
    beats={beats}
    product={FILM_PRODUCT.kind}
    tint={FILM_PRODUCT.tint}
    label={t(locale, "filmStageLabel")}
  />

  {/*
    THE CODA. Outside the film, on the page's own ground.

    The film's typography is one line a frame, which is right for a film and useless for anything
    that has to be read. So the two things that must be readable — her statement about what a
    review is for, and the boundary that travels with the method everywhere it appears — live
    here, at a size and on a ground that can carry them, with the way onward.
  */}
  <section class="coda" aria-labelledby="coda-heading">
    <div class="container coda-inner">
      <p class="eyebrow">{t(locale, "filmCodaEyebrow")}</p>
      <h2 class="coda-heading" id="coda-heading">{t(locale, "filmCodaHeading")}</h2>

      {
        personLocale.philosophy?.statement && (
          <blockquote class="coda-quote">
            <p>{personLocale.philosophy.statement}</p>
          </blockquote>
        )
      }

      <p class="coda-boundary">{methodLocale.boundaryStatement}</p>

      <div class="coda-actions">
        <BeautyButton href={path.method(locale)}>{t(locale, "filmReadMethod")}</BeautyButton>
        <BeautyButton href={path.reviewsIndex(locale)} variant="quiet">
          {t(locale, "exploreReviews")}
        </BeautyButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
   * THE CODA CONTINUES THE MORNING, it does not start a new day.
   *
   * It used to open on the wine ground, which put a hard dark edge directly under the film's last
   * frame — and the film's last frame is its brightest. The transformation the whole piece builds
   * towards was undone by a colour change in the first pixel after it. It now begins in the blush
   * the film ends in and settles into the page's own ivory.
   */
  .coda {
    position: relative;
    padding-block: var(--space-12) var(--space-10);
    background: linear-gradient(180deg, var(--palette-blush) 0%, var(--palette-cream) 40%, var(--palette-ivory) 100%);
  }

  .coda-inner {
    display: grid;
    justify-items: start;
    max-inline-size: var(--layout-max-text);
  }

  .coda .eyebrow {
    color: var(--color-accent-clay);
  }

  .coda-heading {
    margin-block-start: var(--space-3);
    font-size: calc(var(--type-display-md) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-md) * var(--type-arabic-leading-factor));
    color: var(--color-text-primary);
    max-inline-size: 18ch;
  }

  .coda-quote {
    margin-block-start: var(--space-6);
    font-family: var(--type-family-accent);
    font-size: calc(var(--type-display-sm) * var(--type-arabic-size-factor));
    line-height: calc(1.32 * var(--type-arabic-leading-factor));
    color: var(--color-text-primary);
  }

  .coda-boundary {
    margin-block-start: var(--space-5);
    font-size: calc(var(--type-body-sm) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-sm) * var(--type-arabic-leading-factor));
    color: var(--color-text-secondary);
  }

  .coda-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-block-start: var(--space-6);
  }

  @media (min-width: 1024px) {
    .coda {
      padding-block: var(--space-14) var(--space-12);
    }
  }
</style>
