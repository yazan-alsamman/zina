---
/**
 * THE HOMEPAGE — /{locale}/
 *
 * ============================================================================
 * PHASE 11 — STATE A, WITH REAL PHOTOGRAPHY
 * ============================================================================
 * Phase 5 composed this page for State B (no photography existed). The project owner has since
 * supplied photographs of Zina, so the page now opens in State A: an editorial campaign
 * composition with her portrait at the centre, and the ARGUMENT of the page — real testing, real
 * conditions, a verdict in her own words — still carried entirely by real records.
 *
 * Visual hierarchy, in order: Zina · her voice · her testing · her reviews · the products.
 * The 3D products are atmosphere around her, never the subject.
 *
 * SECTIONS
 *   1 opening      tagline as the h1, portrait under an arch, floating products, record count
 *   2 marquee      the categories actually present in this locale's records
 *   3 story        the featured record told as PRODUCT → TESTED → EXPERIENCE → RESULT → VERDICT
 *                  (still exactly one conditions block and one observation on this page)
 *   4 ritual       the Method's six stages, with the boundary statement travelling with them
 *   5 recent       three review cards
 *   6 meet         Zina: the short bio and what the work involves, linked to About
 *   7 closing      the philosophy statement on the wine ground
 *
 * Every link goes to an implemented route. No section is a teaser for something that does not exist.
 */
import type { GetStaticPaths } from "astro";
import type { Locale } from "../../../content/schema/types";
import {
  LOCALES,
  IS_INDEXABLE_BUILD,
  brandById,
  featuredReviews,
  method,
  person,
  reviews as reviewsIn,
} from "../../lib/content";
import { absoluteUrl, isImplemented, path, robotsContent } from "../../lib/routing";
import { jsonLd, personSchema, templatedMeta } from "../../lib/seo";
import { t } from "../../lib/ui-strings";
import { isolateIdentifier, isolateValue } from "../../lib/bidi";
import { countedNoun, formatCount } from "../../lib/format";
import { cosmeticForCategory } from "../../lib/cosmetic-kinds";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewEntry from "../../components/review/ReviewEntry.astro";
import EditorialImage from "../../components/beauty/EditorialImage.astro";
import FloatingCosmetic from "../../components/beauty/FloatingCosmetic.astro";
import BeautyButton from "../../components/beauty/BeautyButton.astro";
import VerdictSeal from "../../components/beauty/VerdictSeal.astro";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };

const personRecord = person();
const personLocale = personRecord.locales[locale]!;
const methodRecord = method();
const methodLocale = methodRecord.locales[locale]!;

const records = reviewsIn(locale);
const featured = featuredReviews(locale)[0] ?? records[0];
const recent = records.filter((r) => r.id !== featured?.id).slice(0, 3);

const featuredContent = featured?.locales[locale];
const conditions = (featuredContent?.conditions ?? []).slice(0, 3);
const observation = featuredContent?.observations?.[0];
const strength = featuredContent?.strengths?.[0];
const limitation = featuredContent?.limitations?.[0];
const verdict = (featuredContent as { verdict?: { summary?: string; wouldRepurchase?: string } } | undefined)?.verdict;
const featuredBrand = featured ? brandById(featured.entity.brandId) : undefined;
const featuredBrandName = featuredBrand?.locales?.[locale]?.name ?? featuredBrand?.slug;
const featuredCosmetic = cosmeticForCategory(featured?.entity.category);

const stages = methodRecord.stageOrder
  .map((key) => methodLocale.stages.find((s) => s.key === key))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

/** The categories this locale's records actually cover — never a padded list. */
const categories = [...new Set(records.map((r) => r.entity.category))];

/**
 * The h1 is Zina's own tagline, split at its first clause so the second half can be set in the
 * italic accent. Splitting on the comma works for both scripts (Latin "," and Arabic "،").
 */
const tagline = personLocale.tagline;
const splitAt = tagline.search(/[,،]/);
const taglineHead = splitAt > 0 ? tagline.slice(0, splitAt + 1) : tagline;
const taglineTail = splitAt > 0 ? tagline.slice(splitAt + 1).trim() : "";

const name = personRecord.name[locale === "ar" ? "arabic" : "latin"];
const expertise = (personLocale.expertise ?? []).slice(0, 5);

const selfPath = path.home(locale);
const meta = templatedMeta(personLocale.professionalTitle, personLocale.bios.short, {
  canonical: absoluteUrl(selfPath),
  robots: robotsContent(IS_INDEXABLE_BUILD),
  locale,
});

const alternates = [
  ...LOCALES.map((l) => ({ hreflang: l, href: absoluteUrl(path.home(l)) })),
  { hreflang: "x-default", href: absoluteUrl(path.home("en")) },
];

/** Person only — no Organization, no award, no credential, no unverified location. */
const schemas = [jsonLd(personSchema(personRecord, locale))];
---

<BaseLayout
  locale={locale}
  meta={meta}
  alternates={alternates}
  schemas={schemas}
  switcherHref={path.home(locale === "en" ? "ar" : "en")}
>
  {/* ================================================================ 1 · opening */}
  <section class="opening opening--portrait" aria-labelledby="hero-title">
    <div class="opening-atmosphere" aria-hidden="true">
      <span class="organic organic--glow opening-glow"></span>
      <span class="organic organic--champagne opening-glow-2"></span>
    </div>

    <div class="container container--wide opening-inner">
      <div class="statement-block">
        <p class="eyebrow enter">{personLocale.professionalTitle}</p>

        <h1 class="statement" id="hero-title">
          <span class="statement-head enter" style="--enter-step: 1">{taglineHead}</span>
          {taglineTail && <span class="statement-tail accent enter" style="--enter-step: 2">{taglineTail}</span>}
        </h1>

        <p class="hero-intro enter" style="--enter-step: 3">{personLocale.bios.homepageIntro}</p>

        <div class="hero-actions enter" style="--enter-step: 4">
          <BeautyButton href={path.reviewsIndex(locale)}>{t(locale, "exploreReviews")}</BeautyButton>
          <BeautyButton href={path.method(locale)} variant="quiet">{t(locale, "howITest")}</BeautyButton>
        </div>

        <p class="attribution enter" style="--enter-step: 5">
          <span class="name">{name}</span>
          <span class="method-line">{t(locale, "homeMethodLead")}</span>
        </p>
      </div>

      <div class="portrait enter-fade" style="--enter-step: 1">
        <span class="portrait-arch" aria-hidden="true"></span>
        <span class="organic organic--ring portrait-ring" aria-hidden="true"></span>
        <span class="organic organic--petal organic--drift portrait-petal" aria-hidden="true"></span>

        <EditorialImage
          photo="portraitGlow"
          locale={locale}
          mask="arch"
          ratio="4 / 5.3"
          priority={true}
          sizes="(min-width: 1024px) 34vw, (min-width: 768px) 55vw, 82vw"
          widths={[420, 640, 860, 1080]}
          class="portrait-image"
        />

        <p class="portrait-caption">
          <span class="caption-count" set:html={isolateValue(formatCount(records.length, locale))} />
          <span class="caption-text">
            <span class="label">{countedNoun(records.length, locale, { one: t(locale, "reviewCountOne"), other: t(locale, "reviewCount") })}</span>
            <span class="caption-sub">{t(locale, "inThisLocale")}</span>
          </span>
        </p>

        <FloatingCosmetic kind="serum" tint="rose" depth={0.9} yaw={-0.6} tilt={0.12} class="hero-cosmetic hero-cosmetic--serum" />
        <FloatingCosmetic kind="jar" tint="blush" depth={1} yaw={-0.3} class="hero-cosmetic hero-cosmetic--jar" />
        <FloatingCosmetic kind="lipstick" tint="rose" depth={0.6} yaw={0.4} tilt={-0.25} class="hero-cosmetic hero-cosmetic--lipstick" />
        <FloatingCosmetic kind="perfume" tint="blush" depth={0.35} yaw={0.55} desktopOnly class="hero-cosmetic hero-cosmetic--perfume" />
        <FloatingCosmetic kind="compact" tint="blush" depth={0.7} yaw={0.2} desktopOnly class="hero-cosmetic hero-cosmetic--compact" />
      </div>
    </div>

    <p class="scroll-cue" aria-hidden="true"><span>{t(locale, "scrollCue")}</span></p>
  </section>

  {/* ================================================================ 2 · marquee */}
  {
    categories.length > 0 && (
      <section class="marquee" aria-label={t(locale, "categoriesTested")}>
        {/* Two IDENTICAL tracks so the loop is seamless. Only the first list is exposed to
            assistive technology; every repetition exists for the eye alone. */}
        {[0, 1].map((track) => (
          <div class="marquee-track" aria-hidden={track === 1 ? "true" : undefined}>
            {[0, 1, 2].map((copy) => (
              <ul class="marquee-list plain" aria-hidden={track === 0 && copy === 0 ? undefined : "true"}>
                {categories.map((category) => (
                  <li class="marquee-item">{category}</li>
                ))}
              </ul>
            ))}
          </div>
        ))}
      </section>
    )
  }

  {/* ================================================================ 3 · the story (the proof) */}
  {
    featured && featuredContent && (
      <section class="featured story" aria-labelledby="featured-heading">
        <span class="organic organic--glow story-glow" aria-hidden="true" />
        <div class="container container--wide story-inner">
          <div class="story-visual">
            <div class="story-visual-sticky">
              <EditorialImage
                photo="closeupComplexion"
                locale={locale}
                mask="pebble"
                ratio="4 / 5"
                parallax={true}
                sizes="(min-width: 1024px) 36vw, 88vw"
                class="story-image reveal-fade"
              />
              <FloatingCosmetic
                kind={featuredCosmetic.kind}
                tint={featuredCosmetic.tint}
                depth={0.9}
                yaw={-0.5}
                class="story-cosmetic"
              />
              <p class="story-chip">
                <span class="label">{t(locale, "storyTested")}</span>
                <span class="story-chip-text">{featuredContent.subtitle}</span>
              </p>
            </div>
          </div>

          <div class="story-copy">
            <p class="eyebrow reveal">{t(locale, "featuredReview")}</p>
            <h2 class="section-title reveal" id="featured-heading">{t(locale, "storyHeading")}</h2>

            <ol class="story-steps plain">
              <li class="step reveal">
                <span class="step-number" aria-hidden="true">01</span>
                <div class="step-body">
                  <h3 class="step-title">{t(locale, "storyProduct")}</h3>
                  <p class="label disclosure">{featuredContent.disclosureLabel}</p>
                  <a class="featured-title-link" href={path.review(locale, featuredContent.slug!)}>
                    <span class="featured-title">{featuredContent.title}</span>
                  </a>
                  <p class="featured-identity">
                    {featuredBrandName && <Fragment set:html={isolateIdentifier(featuredBrandName, locale)} />}
                    <span aria-hidden="true"> · </span>
                    <span>{featured.entity.productType ?? featured.entity.category}</span>
                  </p>
                </div>
              </li>

              <li class="step reveal">
                <span class="step-number" aria-hidden="true">02</span>
                <div class="step-body">
                  <h3 class="step-title">{t(locale, "storyTested")}</h3>
                  {featuredContent.testingContext && <p class="step-text">{featuredContent.testingContext}</p>}
                  {conditions.length > 0 && (
                    <dl class="conditions">
                      {conditions.map((condition) => (
                        <div class="condition">
                          <dt class="label">{condition.label}</dt>
                          <dd class="record" set:html={isolateValue(condition.value)} />
                        </div>
                      ))}
                    </dl>
                  )}
                </div>
              </li>

              {observation && (
                <li class="step reveal">
                  <span class="step-number" aria-hidden="true">03</span>
                  <div class="step-body">
                    <h3 class="step-title">{t(locale, "storyExperience")}</h3>
                    <blockquote class="observation">
                      <p class="observation-when label">
                        <span set:html={isolateValue(observation.at)} /> · {observation.aspect}
                      </p>
                      <p>{observation.note}</p>
                    </blockquote>
                  </div>
                </li>
              )}

              {(strength || limitation) && (
                <li class="step reveal">
                  <span class="step-number" aria-hidden="true">04</span>
                  <div class="step-body">
                    <h3 class="step-title">{t(locale, "storyResult")}</h3>
                    <dl class="result-pair">
                      {strength && (
                        <div class="result result--plus">
                          <dt class="label">{t(locale, "strengths")}</dt>
                          <dd>{strength}</dd>
                        </div>
                      )}
                      {limitation && (
                        <div class="result result--minus">
                          <dt class="label">{t(locale, "limitations")}</dt>
                          <dd>{limitation}</dd>
                        </div>
                      )}
                    </dl>
                  </div>
                </li>
              )}

              {verdict?.summary && (
                <li class="step step--verdict reveal">
                  <span class="step-number" aria-hidden="true">05</span>
                  <div class="step-body">
                    <h3 class="step-title">{t(locale, "storyVerdict")}</h3>
                    <p class="verdict-summary">{verdict.summary}</p>
                    <VerdictSeal locale={locale} value={verdict.wouldRepurchase} />
                  </div>
                </li>
              )}
            </ol>

            <p class="featured-link reveal">
              <BeautyButton href={path.review(locale, featuredContent.slug!)}>{t(locale, "readMyVerdict")}</BeautyButton>
            </p>
          </div>
        </div>
      </section>
    )
  }

  {/* ================================================================ 4 · the ritual (method) */}
  <section class="method-well" aria-labelledby="method-heading">
    <div class="container container--wide method-inner">
      <div class="method-visual reveal-fade">
        <EditorialImage
          photo="studioMonochrome"
          locale={locale}
          mask="arch"
          ratio="3 / 4"
          parallax={true}
          sizes="(min-width: 1024px) 28vw, 70vw"
          class="method-image"
        />
        <span class="organic organic--ring method-ring" aria-hidden="true"></span>
        <FloatingCosmetic kind="compact" tint="blush" depth={0.7} yaw={0.1} class="method-cosmetic" />
      </div>

      <div class="method-copy">
        <p class="eyebrow reveal">{t(locale, "methodEyebrow")}</p>
        <h2 class="section-title reveal" id="method-heading">{methodLocale.name}</h2>

        <ol class="stages plain">
          {
            stages.map((stage, index) => (
              <li class="stage reveal">
                <span class="stage-number" set:html={isolateValue(String(index + 1).padStart(2, "0"))} />
                <a class="stage-name" href={`${path.method(locale)}#${stage.key}`}>{stage.name}</a>
              </li>
            ))
          }
        </ol>

        {/* The boundary travels with the method, everywhere it appears. */}
        <p class="boundary-line reveal">{methodLocale.boundaryStatement}</p>

        <p class="method-cta reveal">
          <BeautyButton href={path.method(locale)} variant="outline">{methodLocale.tagline}</BeautyButton>
        </p>
      </div>
    </div>
  </section>

  {/* ================================================================ 5 · recent reviews */}
  {
    recent.length > 0 && (
      <section class="recent" aria-labelledby="recent-heading">
        <div class="container container--wide">
          <div class="recent-head">
            <div>
              <p class="eyebrow reveal">{t(locale, "reviews")}</p>
              <h2 class="section-title reveal" id="recent-heading">{t(locale, "recentReviews")}</h2>
            </div>
            <p class="all-link reveal">
              <a class="link-quiet" href={path.reviewsIndex(locale)}>
                {t(locale, "viewAllReviews")}
                <span class="count record">
                  <Fragment set:html={isolateValue(formatCount(records.length, locale))} />
                </span>
              </a>
            </p>
          </div>

          <div class="entries">
            {recent.map((review) => <ReviewEntry locale={locale} review={review} headingLevel={3} />)}
          </div>
        </div>
      </section>
    )
  }

  {/* ================================================================ 6 · meet Zina */}
  {
    isImplemented("about") && (
      <section class="meet" aria-labelledby="meet-heading">
        <div class="container container--wide meet-inner">
          <div class="meet-collage">
            <span class="organic organic--petal organic--drift meet-petal" aria-hidden="true" />
            <EditorialImage
              photo="editorialRed"
              locale={locale}
              mask="arch"
              ratio="4 / 5.2"
              sizes="(min-width: 1024px) 30vw, 72vw"
              class="meet-image meet-image--main reveal-fade"
            />
            <EditorialImage
              photo="portraitRadiant"
              locale={locale}
              mask="circle"
              sizes="(min-width: 1024px) 14vw, 36vw"
              widths={[240, 360, 480]}
              class="meet-image meet-image--inset reveal"
            />
            <FloatingCosmetic kind="lipstick" tint="wine" depth={0.8} yaw={-0.2} tilt={0.3} class="meet-cosmetic" />
          </div>

          <div class="meet-copy">
            <p class="eyebrow reveal">{t(locale, "meetZina")}</p>
            <h2 class="section-title reveal" id="meet-heading">{name}</h2>
            <p class="meet-bio reveal">{personLocale.bios.short}</p>

            {expertise.length > 0 && (
              <ul class="expertise plain reveal">
                {expertise.map((item) => (
                  <li>{item.label}</li>
                ))}
              </ul>
            )}

            <div class="meet-actions reveal">
              <BeautyButton href={path.about(locale)}>{t(locale, "discoverApproach")}</BeautyButton>
              {isImplemented("contact") && (
                <BeautyButton href={path.contact(locale)} variant="quiet">{t(locale, "collaborate")}</BeautyButton>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ================================================================ 7 · closing statement */}
  {
    personLocale.philosophy?.statement && (
      <section class="closing tone-wine" aria-label={t(locale, "aboutPhilosophy")}>
        <span class="organic organic--glow closing-glow" aria-hidden="true" />
        <FloatingCosmetic kind="perfume" tint="rose" depth={0.6} yaw={-0.5} class="closing-cosmetic closing-cosmetic--a" />
        <FloatingCosmetic kind="serum" tint="blush" depth={0.3} yaw={0.6} tilt={-0.15} desktopOnly class="closing-cosmetic closing-cosmetic--b" />
        <div class="container closing-inner">
          <p class="eyebrow reveal">{t(locale, "aboutPhilosophy")}</p>
          <blockquote class="closing-quote reveal">
            <p>{personLocale.philosophy.statement}</p>
          </blockquote>
          <p class="closing-sign reveal">— {name}</p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ================================================================ shared */

  .section-title {
    margin-block-start: var(--space-2);
    font-size: calc(var(--type-display-lg) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-lg) * var(--type-arabic-leading-factor));
    max-inline-size: 16ch;
  }

  /* ================================================================ 1 · opening */

  .opening {
    position: relative;
    overflow: clip;
    background: var(--gradient-hero);
    padding-block: var(--space-4) var(--space-10);
  }

  .opening-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .opening-glow {
    inline-size: 46rem;
    block-size: 46rem;
    inset-block-start: -10rem;
    inset-inline-end: -12rem;
  }

  .opening-glow-2 {
    inline-size: 30rem;
    block-size: 30rem;
    inset-block-end: -10rem;
    inset-inline-start: -10rem;
  }

  .opening-watermark {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -0.12em;
    text-align: center;
    font-family: var(--type-family-display);
    font-size: clamp(5rem, 1rem + 17vw, 20rem);
    line-height: 1;
    letter-spacing: var(--type-tracking-display);
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(156 53 86 / 12%);
    user-select: none;
  }

  .opening-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-8);
  }

  .statement-block {
    position: relative;
    z-index: 3;
    align-self: center;
  }

  .statement {
    margin-block-start: var(--space-3);
    display: grid;
    gap: 0.1em;
  }

  .statement-head {
    display: block;
    font-size: calc(var(--type-display-hero) * var(--type-arabic-size-factor));
    line-height: calc(0.95 * var(--type-arabic-leading-factor));
    max-inline-size: 11ch;
  }

  .statement-tail {
    display: block;
    font-size: calc(var(--type-display-md) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-md) * var(--type-arabic-leading-factor));
    max-inline-size: 22ch;
  }

  .hero-intro {
    margin-block-start: var(--space-4);
    max-inline-size: 42ch;
    font-size: calc(var(--type-body-lg) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-lg) * var(--type-arabic-leading-factor));
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-block-start: var(--space-5);
  }

  .attribution {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-3);
    border-block-start: var(--border-rule-hairline);
    max-inline-size: 30rem;
  }

  .name {
    font-family: var(--type-family-display);
    font-size: calc(1.35rem * var(--type-arabic-size-factor));
    color: var(--color-text-primary);
  }

  .method-line {
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-muted);
  }

  /* ---------------------------------------------------------------- portrait composition */

  .portrait {
    position: relative;
    justify-self: center;
    inline-size: min(82vw, 30rem);
    margin-block: var(--space-4) var(--space-4);
  }

  .portrait-arch {
    position: absolute;
    inset: -5% -9% 7% -9%;
    border-radius: var(--radius-arch);
    background: linear-gradient(180deg, rgb(235 201 200 / 70%), rgb(243 233 222 / 40%));
  }

  .portrait-ring {
    inset: -9% -3% 14% 10%;
    border-radius: var(--radius-arch);
  }

  .portrait-petal {
    inline-size: 46%;
    aspect-ratio: 1;
    inset-block-end: -6%;
    inset-inline-end: -16%;
  }

  .portrait-image {
    position: relative;
    z-index: 1;
    box-shadow: var(--shadow-float);
  }

  /* Glass caption card overlapping the portrait's lower edge. */
  .portrait-caption {
    position: absolute;
    z-index: 3;
    inset-block-end: 7%;
    inset-inline-end: -6%;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-soft);
    background: rgb(255 250 247 / 82%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgb(255 255 255 / 70%);
    box-shadow: var(--shadow-soft);
  }

  .caption-count {
    font-family: var(--type-family-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--color-accent-clay);
  }

  .caption-text {
    display: grid;
  }

  .caption-text .label {
    color: var(--color-text-primary);
  }

  .caption-sub {
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-muted);
  }

  .hero-cosmetic--serum {
    inline-size: 32%;
    inset-block-start: 10%;
    inset-inline-start: -18%;
  }

  .hero-cosmetic--jar {
