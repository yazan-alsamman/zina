---
/**
 * THE HOMEPAGE — /{locale}/
 *
 * ============================================================================
 * PHASE 11 — STATE A, WITH REAL PHOTOGRAPHY
 * ============================================================================
 * Phase 5 composed this page for State B (no photography existed). The project owner has since
 * supplied photographs of Zina, so the page now opens in State A: an editorial campaign
 * composition with her portrait at the centre, and the ARGUMENT of the page — real testing, real
 * conditions, a verdict in her own words — still carried entirely by real records.
 *
 * Visual hierarchy, in order: Zina · her voice · her testing · her reviews · the products.
 * The 3D products are atmosphere around her, never the subject.
 *
 * ============================================================================
 * PHASE 12 — THE PAGE AS A SEQUENCE OF SCENES
 * ============================================================================
 * Phase 11 built seven strong sections, and every one of them was LOUD: photography plus products
 * plus a headline, seven times. Phase 12 keeps all seven and changes their rhythm, because a page
 * that never rests has no peaks. The sequence now alternates:
 *
 *   VISUAL  opening   portrait, four products, one of them the anchor
 *   texture marquee   the categories, moving
 *   QUIET   discovery WHAT she tests — type and rules only. No photograph, no product.
 *   VISUAL  story     the proof, with ONE product travelling the length of the section
 *   VISUAL  ritual    the six stages, with a single background product
 *   QUIET   band      a full-bleed beauty frame carrying the section's own heading. No product.
 *   VISUAL  recent    three review cards
 *   QUIET   meet      the collage — two photographs of her, and no packaging at all
 *   QUIET   closing   her sentence, on the wine ground
 *
 * The discovery section is new and is not new COPY: `expertise[].label` and `.detail` were already
 * in the person record and were the one substantial thing the homepage never showed. It answers
 * the question the page previously skipped between "here she is" and "here is a review".
 *
 * Visual hierarchy, unchanged and non-negotiable: Zina · her voice · her testing · her reviews ·
 * the products. The 3D is atmosphere around her, never the subject, and the marquee, the
 * discovery ledger and the "meet Zina" collage carry no packaging at all — the collage lost its
 * nail polish in Phase 12 precisely because the section is two photographs of HER, and a product
 * beside them was competing for the one thing that section is about.
 *
 * Every link goes to an implemented route. No section is a teaser for something that does not exist.
 */
import type { GetStaticPaths } from "astro";
import type { Locale } from "../../../content/schema/types";
import {
  LOCALES,
  IS_INDEXABLE_BUILD,
  brandById,
  featuredReviews,
  method,
  person,
  reviews as reviewsIn,
} from "../../lib/content";
import { absoluteUrl, isImplemented, path, robotsContent } from "../../lib/routing";
import { jsonLd, personSchema, templatedMeta } from "../../lib/seo";
import { t } from "../../lib/ui-strings";
import { isolateIdentifier, isolateValue } from "../../lib/bidi";
import { countedNoun, formatCount } from "../../lib/format";
import { cosmeticForCategory } from "../../lib/cosmetic-kinds";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewEntry from "../../components/review/ReviewEntry.astro";
import EditorialImage from "../../components/beauty/EditorialImage.astro";
import FloatingCosmetic from "../../components/beauty/FloatingCosmetic.astro";
import BeautyButton from "../../components/beauty/BeautyButton.astro";
import VerdictSeal from "../../components/beauty/VerdictSeal.astro";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };

const personRecord = person();
const personLocale = personRecord.locales[locale]!;
const methodRecord = method();
const methodLocale = methodRecord.locales[locale]!;

const records = reviewsIn(locale);
const featured = featuredReviews(locale)[0] ?? records[0];
const recent = records.filter((r) => r.id !== featured?.id).slice(0, 3);

const featuredContent = featured?.locales[locale];
const conditions = (featuredContent?.conditions ?? []).slice(0, 3);
const observation = featuredContent?.observations?.[0];
const strength = featuredContent?.strengths?.[0];
const limitation = featuredContent?.limitations?.[0];
const verdict = (featuredContent as { verdict?: { summary?: string; wouldRepurchase?: string } } | undefined)?.verdict;
const featuredBrand = featured ? brandById(featured.entity.brandId) : undefined;
const featuredBrandName = featuredBrand?.locales?.[locale]?.name ?? featuredBrand?.slug;
const featuredCosmetic = cosmeticForCategory(featured?.entity.category);

const stages = methodRecord.stageOrder
  .map((key) => methodLocale.stages.find((s) => s.key === key))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

/** The categories this locale's records actually cover — never a padded list. */
const categories = [...new Set(records.map((r) => r.entity.category))];

/**
 * The h1 is Zina's own tagline, split at its first clause so the second half can be set in the
 * italic accent. Splitting on the comma works for both scripts (Latin "," and Arabic "،").
 */
const tagline = personLocale.tagline;
const splitAt = tagline.search(/[,،]/);
const taglineHead = splitAt > 0 ? tagline.slice(0, splitAt + 1) : tagline;
const taglineTail = splitAt > 0 ? tagline.slice(splitAt + 1).trim() : "";

const name = personRecord.name[locale === "ar" ? "arabic" : "latin"];
/* All of them, not a preview: the discovery section is now where they live, with their details. */
const expertise = personLocale.expertise ?? [];

const selfPath = path.home(locale);
/*
 * THE META DESCRIPTION IS `homepageIntro`, NOT `bios.short`.
 *
 * `bios.short` is 199 characters in English and 165 in Arabic. A search result shows roughly 155
 * before it truncates, so the homepage — the most important page on the site — was publishing a
 * sentence that got cut mid-clause. `homepageIntro` (103 / 72) is the same voice, is the sentence
 * already set under the hero headline, and fits whole. The longer bio still carries the Person
 * schema's `description`, where there is no length to fit.
 */
const meta = templatedMeta(personLocale.professionalTitle, personLocale.bios.homepageIntro, {
  canonical: absoluteUrl(selfPath),
  robots: robotsContent(IS_INDEXABLE_BUILD),
  locale,
});

const alternates = [
  ...LOCALES.map((l) => ({ hreflang: l, href: absoluteUrl(path.home(l)) })),
  { hreflang: "x-default", href: absoluteUrl(path.home("en")) },
];

/** Person only — no Organization, no award, no credential, no unverified location. */
const schemas = [jsonLd(personSchema(personRecord, locale))];
---

<BaseLayout
  locale={locale}
  meta={meta}
  alternates={alternates}
  schemas={schemas}
  switcherHref={path.home(locale === "en" ? "ar" : "en")}
>
  {/* ================================================================ 1 · opening */}
  <section class="opening opening--portrait" aria-labelledby="hero-title">
    {/* The studio light: a softbox high and right, a champagne bounce low and left, and one
        leak crossing the frame. The same direction the 3D products are lit from. */}
    <div class="opening-atmosphere" aria-hidden="true">
      <span class="organic organic--glow opening-glow"></span>
      <span class="organic organic--champagne opening-glow-2"></span>
      <span class="organic organic--leak organic--breathe opening-leak"></span>
    </div>

    <p class="vertical-label opening-spine" aria-hidden="true">{t(locale, "chapterLabel")} 01</p>

    <div class="container container--wide opening-inner">
      <div class="statement-block">
        <p class="eyebrow enter">{personLocale.professionalTitle}</p>

        <h1 class="statement" id="hero-title">
          <span class="statement-head enter" style="--enter-step: 1">{taglineHead}</span>
          {taglineTail && <span class="statement-tail accent enter" style="--enter-step: 2">{taglineTail}</span>}
        </h1>

        <p class="hero-intro enter" style="--enter-step: 3">{personLocale.bios.homepageIntro}</p>

        <div class="hero-actions enter" style="--enter-step: 4">
          <BeautyButton href={path.reviewsIndex(locale)}>{t(locale, "exploreReviews")}</BeautyButton>
          <BeautyButton href={path.method(locale)} variant="quiet">{t(locale, "howITest")}</BeautyButton>
        </div>

        <p class="attribution enter" style="--enter-step: 5">
          <span class="name">{name}</span>
          <span class="method-line">{t(locale, "homeMethodLead")}</span>
        </p>
      </div>

      <div class="portrait enter-fade" style="--enter-step: 1">
        <span class="portrait-arch" aria-hidden="true"></span>
        <span class="organic organic--ring portrait-ring" aria-hidden="true"></span>
        <span class="organic organic--petal organic--drift portrait-petal" aria-hidden="true"></span>

        <EditorialImage
          photo="portraitGlow"
          locale={locale}
          mask="arch"
          ratio="4 / 5.3"
          priority={true}
          sizes="(min-width: 1024px) 34vw, (min-width: 768px) 55vw, 82vw"
          widths={[420, 640, 860, 1080]}
          class="portrait-image"
        />

        <p class="portrait-caption">
          <span class="caption-count" set:html={isolateValue(formatCount(records.length, locale))} />
          <span class="caption-text">
            <span class="label">{countedNoun(records.length, locale, { one: t(locale, "reviewCountOne"), other: t(locale, "reviewCount") })}</span>
            <span class="caption-sub">{t(locale, "inThisLocale")}</span>
          </span>
        </p>

        {/* ONE ANCHOR, THEN SUPPORT. The serum is the only `fore` product on this screen: it is
            nearest, answers the cursor most, turns furthest as the page moves, and outranks the
            others when the scene's budget has to choose. The jar and lipstick are midground; the
            perfume and the powder jar are background atmosphere and only appear on wide screens.
            On a phone the budget is two, and priority decides which two — never a scramble. */}
        <FloatingCosmetic
          kind="serum"
          tint="rose"
          layer="fore"
          depth={0.9}
          yaw={-0.6}
          tilt={0.12}
          spin={0.9}
          approach={0.7}
          priority={2.4}
          class="hero-cosmetic hero-cosmetic--serum"
        />
        <FloatingCosmetic kind="jar" tint="blush" layer="mid" depth={0.8} yaw={-0.3} spin={0.5} priority={0.9} class="hero-cosmetic hero-cosmetic--jar" />
        <FloatingCosmetic kind="lipcase" tint="rose" layer="mid" depth={0.6} yaw={0.4} tilt={-0.25} spin={0.6} priority={0.3} class="hero-cosmetic hero-cosmetic--lipstick" />
      </div>
    </div>

    <p class="scroll-cue" aria-hidden="true"><span>{t(locale, "scrollCue")}</span></p>
  </section>

  {/* ================================================================ 2 · marquee */}
  {
    categories.length > 0 && (
      <section class="marquee" aria-label={t(locale, "categoriesTested")}>
        {/* Two IDENTICAL tracks so the loop is seamless. Only the first list is exposed to
            assistive technology; every repetition exists for the eye alone. */}
        {[0, 1].map((track) => (
          <div class="marquee-track" aria-hidden={track === 1 ? "true" : undefined}>
            {[0, 1, 2].map((copy) => (
              <ul class="marquee-list plain" aria-hidden={track === 0 && copy === 0 ? undefined : "true"}>
                {categories.map((category) => (
                  <li class="marquee-item">{category}</li>
                ))}
              </ul>
            ))}
          </div>
        ))}
      </section>
    )
  }

  {/* ================================================================ 3 · discovery — QUIET
      Type and rules. No photograph, no product, no gradient trick. The page has just been loud
      and is about to be loud again; this is the breath between them, and it is also the beat the
      Phase 11 homepage skipped — what, specifically, she tests. */}
  {
    expertise.length > 0 && (
      <section class="discovery" aria-labelledby="discovery-heading">
        <div class="container container--wide discovery-inner">
          <div class="discovery-head">
            <p class="eyebrow reveal">{t(locale, "expertiseEyebrow")}</p>
            <h2 class="discovery-title reveal" id="discovery-heading">{t(locale, "expertiseHeading")}</h2>
            <span class="section-mark discovery-mark" aria-hidden="true">02</span>
          </div>

          <ol class="discovery-list plain">
            {expertise.map((item, index) => (
              <li class="discovery-item reveal-step" style={`--reveal-step: ${index}`}>
                <span class="discovery-number record" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="discovery-label">{item.label}</h3>
                {item.detail && <p class="discovery-detail">{item.detail}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {/* ================================================================ 3 · the story (the proof) */}
  {
    featured && featuredContent && (
      <section class="featured story" aria-labelledby="featured-heading">
        <span class="seam seam--blush" aria-hidden="true" />
        <span class="organic organic--glow story-glow" aria-hidden="true" />
        <div class="container container--wide story-inner">
          <span class="section-mark story-mark" aria-hidden="true">03</span>

          {/* THE PRODUCT JOURNEY. This slot is not a box, it is a RAIL: a tall invisible corridor
              down the visual column of the section. The scene draws the product into a small box
              that travels the path below as you scroll — far out at the top, swinging in across
              the photograph, back out, and settling low beside the verdict — turning through most
              of a half-turn on the way. One product does this on this page. Doing it to all of
              them would be a screensaver. Desktop and tablet only: on a phone the column is the
              content, and a travelling object would cross it. */}
          <FloatingCosmetic
            kind={featuredCosmetic.kind}
            tint={featuredCosmetic.tint}
            layer="fore"
            depth={0.95}
            yaw={-0.5}
            spin={2.4}
            approach={0.85}
            priority={2.6}
            path="0.82,0 0.06,0.32 0.66,0.62 0.12,1"
            size={0.4}
            wideOnly
            class="story-journey"
          />
          <div class="story-visual">
            <div class="story-visual-sticky">
              <EditorialImage
                photo="closeupComplexion"
                locale={locale}
                mask="pebble"
                ratio="4 / 5"
                parallax={true}
                sizes="(min-width: 1024px) 36vw, 88vw"
                class="story-image reveal-fade"
              />
              {/* The phone composition: no rail, one quiet product tucked against the frame. */}
              <FloatingCosmetic
                kind={featuredCosmetic.kind}
                tint={featuredCosmetic.tint}
                layer="mid"
                depth={0.9}
                yaw={-0.5}
                spin={0.6}
                priority={1.2}
                class="story-cosmetic"
              />
              <p class="story-chip">
                <span class="label">{t(locale, "storyTested")}</span>
                <span class="story-chip-text">{featuredContent.subtitle}</span>
              </p>
            </div>
          </div>

          <div class="story-copy">
            <p class="eyebrow reveal">{t(locale, "featuredReview")}</p>
            <h2 class="section-title reveal" id="featured-heading">{t(locale, "storyHeading")}</h2>

            <ol class="story-steps plain">
              <li class="step reveal">
                <span class="step-number" aria-hidden="true">01</span>
                <div class="step-body">
                  <h3 class="step-title">{t(locale, "storyProduct")}</h3>
                  <p class="label disclosure">{featuredContent.disclosureLabel}</p>
                  <a class="featured-title-link" href={path.review(locale, featuredContent.slug!)}>
                    <span class="featured-title">{featuredContent.title}</span>
                  </a>
                  <p class="featured-identity">
                    {featuredBrandName && <Fragment set:html={isolateIdentifier(featuredBrandName, locale)} />}
                    <span aria-hidden="true"> · </span>
                    <span>{featured.entity.productType ?? featured.entity.category}</span>
                  </p>
                </div>
              </li>

              <li class="step reveal">
                <span class="step-number" aria-hidden="true">02</span>
                <div class="step-body">
                  <h3 class="step-title">{t(locale, "storyTested")}</h3>
                  {featuredContent.testingContext && <p class="step-text">{featuredContent.testingContext}</p>}
                  {conditions.length > 0 && (
                    <dl class="conditions">
                      {conditions.map((condition) => (
                        <div class="condition">
                          <dt class="label">{condition.label}</dt>
                          <dd class="record" set:html={isolateValue(condition.value)} />
                        </div>
                      ))}
                    </dl>
                  )}
                </div>
              </li>

              {observation && (
                <li class="step reveal">
                  <span class="step-number" aria-hidden="true">03</span>
                  <div class="step-body">
                    <h3 class="step-title">{t(locale, "storyExperience")}</h3>
                    <blockquote class="observation">
                      <p class="observation-when label">
                        <span set:html={isolateValue(observation.at)} /> · {observation.aspect}
                      </p>
                      <p>{observation.note}</p>
                    </blockquote>
                  </div>
                </li>
              )}

              {(strength || limitation) && (
                <li class="step reveal">
                  <span class="step-number" aria-hidden="true">04</span>
                  <div class="step-body">
                    <h3 class="step-title">{t(locale, "storyResult")}</h3>
                    <dl class="result-pair">
                      {strength && (
                        <div class="result result--plus">
                          <dt class="label">{t(locale, "strengths")}</dt>
                          <dd>{strength}</dd>
                        </div>
                      )}
                      {limitation && (
                        <div class="result result--minus">
                          <dt class="label">{t(locale, "limitations")}</dt>
                          <dd>{limitation}</dd>
                        </div>
                      )}
                    </dl>
                  </div>
                </li>
              )}

              {verdict?.summary && (
                <li class="step step--verdict reveal">
                  <span class="step-number" aria-hidden="true">05</span>
                  <div class="step-body">
                    <h3 class="step-title">{t(locale, "storyVerdict")}</h3>
                    <p class="verdict-summary">{verdict.summary}</p>
                    <VerdictSeal locale={locale} value={verdict.wouldRepurchase} />
                  </div>
                </li>
              )}
            </ol>

            <p class="featured-link reveal">
              <BeautyButton href={path.review(locale, featuredContent.slug!)}>{t(locale, "readMyVerdict")}</BeautyButton>
            </p>
          </div>
        </div>
      </section>
    )
  }

  {/* ================================================================ 4 · the ritual (method) */}
  <section class="method-well" aria-labelledby="method-heading">
    <div class="container container--wide method-inner">
      <span class="section-mark section-mark--solid method-mark" aria-hidden="true">04</span>
      <div class="method-visual reveal-fade">
        <EditorialImage
          photo="studioMonochrome"
          locale={locale}
          mask="arch"
          ratio="3 / 4"
          parallax={true}
          sizes="(min-width: 1024px) 28vw, 70vw"
          class="method-image"
        />
        <span class="organic organic--ring method-ring" aria-hidden="true"></span>
        {/* The ritual section is about the stages, not the packaging: ONE background object,
            quiet, low priority, so the numbered list is what the eye lands on. */}
        <FloatingCosmetic kind="brush" tint="wine" layer="back" depth={0.5} yaw={0.1} spin={0.4} priority={-0.2} class="method-cosmetic" />
      </div>

      <div class="method-copy">
        <p class="eyebrow reveal">{t(locale, "methodEyebrow")}</p>
        <h2 class="section-title reveal" id="method-heading">{methodLocale.name}</h2>

        <ol class="stages plain">
          {
            stages.map((stage, index) => (
              <li class="stage reveal">
                <span class="stage-number" set:html={isolateValue(String(index + 1).padStart(2, "0"))} />
                <a class="stage-name" href={`${path.method(locale)}#${stage.key}`}>{stage.name}</a>
              </li>
            ))
          }
        </ol>

        {/* The boundary travels with the method, everywhere it appears. */}
        <p class="boundary-line reveal">{methodLocale.boundaryStatement}</p>

        <div class="method-cta reveal">
          <BeautyButton href={path.method(locale)} variant="outline">{methodLocale.tagline}</BeautyButton>
          {/* The film presents these same six stages. It is offered here, next to them, rather
              than in the navigation: it is an experience to be entered deliberately, not a
              destination to be browsed past. */}
          <BeautyButton href={path.film(locale)} variant="quiet">{t(locale, "filmEnter")}</BeautyButton>
        </div>
      </div>
    </div>
  </section>

  {/* ================================================================ 5 · recent reviews */}
  {
    recent.length > 0 && (
      <section class="recent" aria-labelledby="recent-heading">
        {/* THE BAND — the one full-bleed photograph on the page, and the only place the heading
            is set over an image rather than beside one. It is the beauty frame precisely because
            this is where the page turns to the reviews: the subject of the work is what a formula
            does on skin, and this is the only photograph in the set where that is legible. No 3D
            product appears over it; the photograph does not need help. */}
        <div class="recent-band">
          <EditorialImage
            photo="beautyCloseup"
            locale={locale}
            mask="none"
            tone="deep"
            ratio="4 / 5"
            parallax={true}
            sizes="100vw"
            widths={[640, 960, 1280, 1800, 2400]}
            class="recent-band-image"
          />
          <div class="container container--wide recent-band-copy">
            <p class="eyebrow reveal">{t(locale, "recentEyebrow")}</p>
            <h2 class="recent-title reveal" id="recent-heading">{t(locale, "recentReviews")}</h2>
          </div>
          <p class="vertical-label recent-spine" aria-hidden="true">
            {t(locale, "chapterLabel")} 05
          </p>
        </div>

        <div class="container container--wide">
          <div class="recent-head">
            <p class="all-link reveal">
              <a class="link-quiet" href={path.reviewsIndex(locale)}>
                {t(locale, "viewAllReviews")}
                <span class="count record">
                  <Fragment set:html={isolateValue(formatCount(records.length, locale))} />
                </span>
              </a>
            </p>
          </div>

          <div class="entries">
            {recent.map((review) => <ReviewEntry locale={locale} review={review} headingLevel={3} />)}
          </div>
        </div>
      </section>
    )
  }

  {/* ================================================================ 6 · meet Zina */}
  {
    isImplemented("about") && (
      <section class="meet" aria-labelledby="meet-heading">
        <div class="container container--wide meet-inner">
          <div class="meet-collage">
            <span class="organic organic--petal organic--drift meet-petal" aria-hidden="true" />
            <EditorialImage
              photo="editorialRed"
              locale={locale}
              mask="arch"
              ratio="4 / 5.2"
              sizes="(min-width: 1024px) 30vw, 72vw"
              class="meet-image meet-image--main reveal-fade"
            />
            <EditorialImage
              photo="portraitRadiant"
              locale={locale}
              mask="circle"
              sizes="(min-width: 1024px) 14vw, 36vw"
              widths={[240, 360, 480]}
              class="meet-image meet-image--inset reveal"
            />
          </div>

          <div class="meet-copy">
            <p class="eyebrow reveal">{t(locale, "meetZina")}</p>
            <h2 class="section-title reveal" id="meet-heading">{name}</h2>
            <p class="meet-bio reveal">{personLocale.bios.short}</p>

            <div class="meet-actions reveal">
              <BeautyButton href={path.about(locale)}>{t(locale, "discoverApproach")}</BeautyButton>
              {isImplemented("contact") && (
                <BeautyButton href={path.contact(locale)} variant="quiet">{t(locale, "collaborate")}</BeautyButton>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ================================================================ 7 · closing statement */}
  {
    personLocale.philosophy?.statement && (
      <section class="closing tone-wine" aria-label={t(locale, "aboutPhilosophy")}>
        <span class="organic organic--glow closing-glow" aria-hidden="true" />
        {/* On the wine ground the rim light does the separating work (`light="wine"`), or glass
            simply disappears into the dark. */}
        <FloatingCosmetic
          kind="perfume"
          tint="rose"
          layer="fore"
          depth={0.6}
          yaw={-0.5}
          spin={1.1}
          approach={0.6}
          priority={2}
          light="wine"
          class="closing-cosmetic closing-cosmetic--a"
        />
        <FloatingCosmetic
          kind="balm"
          tint="rose"
          layer="back"
          depth={0.3}
          yaw={0.6}
          tilt={-0.15}
          spin={0.4}
          light="wine"
          wideOnly
          class="closing-cosmetic closing-cosmetic--b"
        />
        <div class="container closing-inner">
          <p class="eyebrow reveal">{t(locale, "closingEyebrow")}</p>
          <blockquote class="closing-quote reveal">
            <p>{personLocale.philosophy.statement}</p>
          </blockquote>
          <p class="closing-sign reveal">— {name}</p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ================================================================ shared */

  .section-title {
    margin-block-start: var(--space-2);
    font-size: calc(var(--type-display-lg) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-lg) * var(--type-arabic-leading-factor));
    max-inline-size: 16ch;
  }

  /* ================================================================ 1 · opening */

  .opening {
    position: relative;
    overflow: clip;
    background: var(--gradient-hero);
    padding-block: var(--space-4) var(--space-10);
  }

  .opening-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .opening-glow {
    inline-size: 46rem;
    block-size: 46rem;
    inset-block-start: -10rem;
    inset-inline-end: -12rem;
  }

  .opening-glow-2 {
    inline-size: 30rem;
    block-size: 30rem;
    inset-block-end: -10rem;
    inset-inline-start: -10rem;
  }

  .opening-watermark {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -0.12em;
    text-align: center;
    font-family: var(--type-family-display);
    font-size: clamp(5rem, 1rem + 17vw, 20rem);
    line-height: 1;
    letter-spacing: var(--type-tracking-display);
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(184 164 143 / 55%);
    user-select: none;
  }

  .opening-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-8);
  }

  .statement-block {
    position: relative;
    z-index: 3;
    align-self: center;
  }

  .statement {
    margin-block-start: var(--space-3);
    display: grid;
    gap: 0.1em;
  }

  .statement-head {
    display: block;
    font-size: calc(var(--type-display-hero) * var(--type-arabic-size-factor));
    line-height: calc(0.95 * var(--type-arabic-leading-factor));
    max-inline-size: 11ch;
  }

  .statement-tail {
    display: block;
    font-size: calc(var(--type-display-md) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-md) * var(--type-arabic-leading-factor));
    max-inline-size: 22ch;
  }

  .hero-intro {
    margin-block-start: var(--space-4);
    max-inline-size: 42ch;
    font-size: calc(var(--type-body-lg) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-lg) * var(--type-arabic-leading-factor));
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-block-start: var(--space-5);
  }

  .attribution {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-3);
    border-block-start: var(--border-rule-hairline);
    max-inline-size: 30rem;
  }

  .name {
    font-family: var(--type-family-display);
    font-size: calc(1.35rem * var(--type-arabic-size-factor));
    color: var(--color-text-primary);
  }

  .method-line {
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-muted);
  }

  /* ---------------------------------------------------------------- portrait composition */

  .portrait {
    position: relative;
    justify-self: center;
    inline-size: min(82vw, 30rem);
    margin-block: var(--space-4) var(--space-4);
  }

  .portrait-arch {
    position: absolute;
    inset: -5% -9% 7% -9%;
    border-radius: var(--radius-arch);
    background: linear-gradient(180deg, rgb(217 210 202 / 70%), rgb(246 244 242 / 40%));
  }

  .portrait-ring {
    inset: -9% -3% 14% 10%;
    border-radius: var(--radius-arch);
  }

  .portrait-petal {
    inline-size: 46%;
    aspect-ratio: 1;
    inset-block-end: -6%;
    inset-inline-end: -16%;
  }

  /* The one HERO-weight shadow on the site: the portrait is the subject of the page. */
  .portrait-image {
    position: relative;
    z-index: 1;
    box-shadow: var(--shadow-hero);
  }

  /* Glass caption card overlapping the portrait's lower edge. */
  .portrait-caption {
    position: absolute;
    z-index: 3;
    inset-block-end: 7%;
    inset-inline-end: -2%;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-soft);
    background: rgb(255 255 255 / 86%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgb(184 164 143 / 45%);
    box-shadow: var(--shadow-soft);
  }

  .caption-count {
    font-family: var(--type-family-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--color-accent-clay);
  }

  .caption-text {
    display: grid;
  }

  .caption-text .label {
    color: var(--color-text-primary);
  }

  .caption-sub {
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    color: var(--color-text-muted);
  }

  /* THE STILL LIFE. Four objects, arranged as one group rather than sprinkled around a ring:
     the anchor high on the reading side, the jar weighting the base, a small capsule opposite,
     and one background object further out. Every inset is inside the section's clip, so nothing
     is ever cut in half by an edge — a clipped product is the single clearest tell that a 3D
     layer was dropped onto a page rather than composed into it. */
  .hero-cosmetic--serum {
    inline-size: var(--cosmetic-sm);
    inset-block-start: 8%;
    inset-inline-start: -13%;
  }

  .hero-cosmetic--jar {
    inline-size: var(--cosmetic-md);
    inset-block-end: -4%;
    inset-inline-start: -11%;
  }

  .hero-cosmetic--lipstick {
    inline-size: var(--cosmetic-xs);
    inset-block-start: 2%;
    inset-inline-end: 2%;
  }

  .scroll-cue {
    display: none;
  }

  /* MOBILE COMPOSITION — Zina leads. The portrait moves above the headline, products tuck
     inside the screen edge, and the caption card sits within the arch. */
  @media (max-width: 1023px) {
    .opening {
      padding-block: var(--space-3) var(--space-8);
    }

    .opening-inner {
      gap: var(--space-4);
    }

    .portrait {
      order: -1;
      inline-size: min(70vw, 24rem);
      margin-block: var(--space-4) var(--space-2);
    }

    .portrait-caption {
      inset-inline-end: -12%;
      inset-block-end: 5%;
      padding: 0.6rem 0.9rem;
    }

    .caption-count {
      font-size: 2rem;
    }

    .hero-cosmetic--serum {
      inline-size: 34%;
      inset-block-start: 4%;
      inset-inline-start: -16%;
    }

    .hero-cosmetic--jar {
      inline-size: 44%;
      inset-block-end: -8%;
      inset-inline-start: -18%;
    }

    .hero-cosmetic--lipstick {
      inline-size: 30%;
      inset-block-start: -6%;
      inset-inline-end: -12%;
    }

    .statement-block {
      text-align: start;
    }
  }

  /* ================================================================ 2 · marquee */

  .marquee {
    display: flex;
    overflow: hidden;
    padding-block: var(--space-3);
    border-block: 1px solid var(--color-line-hairline);
    background: var(--palette-ivory);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee-track,
  .marquee-list {
    display: flex;
    flex: none;
    align-items: center;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-inline-end: var(--space-5);
    font-family: var(--type-family-accent);
    font-size: calc(clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem) * var(--type-arabic-size-factor));
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .marquee-item::after {
    content: "✦";
    font-family: var(--type-family-ui);
    font-size: 0.9rem;
    color: var(--palette-champagne-metal);
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee var(--motion-marquee-duration) linear infinite;
    }

    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  /* In RTL the loop runs the other way, matching the reading direction. */
  .marquee-track:dir(rtl) {
    animation-direction: reverse;
  }

  /* ================================================================ 3 · story */

  .story {
    position: relative;
    overflow: clip;
    padding-block: var(--space-10);
    background: var(--gradient-ivory-blush);
  }

  .story-glow {
    inline-size: 40rem;
    block-size: 40rem;
    inset-block-start: 20%;
    inset-inline-start: -14rem;
  }

  .story-inner {
    position: relative;
    display: grid;
    gap: var(--space-8);
  }

  .story-visual-sticky {
    position: relative;
    inline-size: min(100%, 30rem);
    margin-inline: auto;
  }

  .story-image {
    box-shadow: var(--shadow-float);
  }

  .story-cosmetic {
    inline-size: var(--cosmetic-md);
    inset-block-end: -8%;
    inset-inline-end: -8%;
  }

  /*
   * PHASE 13. This caption used to sit at the image's TOP-LEFT — which is exactly the corridor the
   * travelling product runs down from tablet width up, and the choreography audit measured the
   * product covering up to 68% of it mid-scroll. Decoration yields to content: from 768 the
   * caption moves to the image's lower-right, where nothing else lives (the fixed phone-only
   * product slot is hidden at that width), and the corridor is left clear. Below 768 there is no
   * rail, so the caption keeps its original position.
   */
  .story-chip {
    position: absolute;
    z-index: 3;
    inset-block-start: 8%;
    inset-inline-start: -4%;
    display: grid;
    gap: 0.15rem;
    max-inline-size: 15rem;
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius-soft);
    background: rgb(255 255 255 / 90%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-soft);
  }

  .story-chip .label {
    color: var(--color-accent-clay);
  }

  .story-chip-text {
    font-family: var(--type-family-display);
    font-size: calc(1.1rem * var(--type-arabic-size-factor));
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .story-steps {
    display: grid;
    margin-block-start: var(--space-6);
    counter-reset: step;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block-start: 1px solid var(--color-line-hairline);
  }

  /* The thread that joins the five stages. */
  .step::before {
    content: "";
    position: absolute;
    inset-block: calc(var(--space-4) + 2.6rem) calc(var(--space-4) * -1);
    inset-inline-start: 1.1rem;
    inline-size: 1px;
    background: linear-gradient(180deg, var(--color-accent-champagne), transparent);
    opacity: 0.5;
  }

  .step:last-child::before {
    display: none;
  }

  .step-number {
    display: grid;
    place-items: center;
    inline-size: 2.3rem;
    block-size: 2.3rem;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
    font-family: var(--type-family-accent);
    font-size: 1rem;
    color: var(--color-accent-clay);
    background: var(--color-ground-card);
  }

  .step-title {
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    font-weight: var(--type-weight-medium);
    letter-spacing: var(--type-tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 2.3rem;
  }

  :global(html[lang="ar"]) .step-title {
    text-transform: none;
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
  }

  .step-body {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .disclosure {
    margin-block-start: var(--space-1);
    color: var(--color-accent-clay);
  }

  .featured-title-link {
    text-decoration: none;
    justify-self: start;
  }

  .featured-title {
    font-family: var(--type-family-display);
    font-size: calc(var(--type-display-md) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-md) * var(--type-arabic-leading-factor));
    color: var(--color-text-primary);
    transition: color var(--motion-duration-base) var(--motion-easing-silk);
  }

  .featured-title-link:hover .featured-title {
    color: var(--color-accent-clay-hover);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .featured-identity,
  .step-text {
    color: var(--color-text-secondary);
    max-inline-size: var(--type-measure-editorial);
  }

  .featured-identity {
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-ui-sm) * var(--type-arabic-size-factor));
  }

  .conditions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }

  .condition {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-soft);
    background: rgb(255 255 255 / 82%);
    border: 1px solid var(--color-line-hairline);
  }

  .conditions dd {
    color: var(--color-accent-mineral);
  }

  .conditions dd :global(bdi) {
    white-space: nowrap;
  }

  .observation {
    position: relative;
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-ground-card);
    box-shadow: var(--shadow-soft);
    font-family: var(--type-family-display);
    font-size: calc(1.35rem * var(--type-arabic-size-factor));
    line-height: calc(1.4 * var(--type-arabic-leading-factor));
    max-inline-size: 38rem;
  }

  .observation::before {
    content: "“";
    position: absolute;
    inset-block-start: -0.35em;
    inset-inline-start: 0.25em;
    font-family: var(--type-family-accent);
    font-size: 4rem;
    color: var(--color-accent-champagne);
  }

  .observation-when {
    margin-block-end: var(--space-1);
    color: var(--color-accent-mineral);
  }

  .result-pair {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-1);
  }

  .result {
    display: grid;
    gap: 0.2rem;
    padding-inline-start: var(--space-2);
    border-inline-start: 2px solid var(--color-accent-champagne);
  }

  .result--minus {
    border-inline-start-color: var(--color-line-strong);
  }

  .result dd {
    color: var(--color-text-primary);
    max-inline-size: 44ch;
  }

  .verdict-summary {
    font-family: var(--type-family-display);
    font-size: calc(var(--type-display-sm) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-sm) * var(--type-arabic-leading-factor));
    color: var(--color-text-primary);
    max-inline-size: 30ch;
    margin-block-end: var(--space-2);
  }

  .featured-link {
    margin-block-start: var(--space-5);
  }

  /* ================================================================ 4 · method */

  .method-well {
    position: relative;
    overflow: clip;
    padding-block: var(--space-10);
    background: var(--gradient-powder-champagne);
    border-start-start-radius: 50% 3rem;
    border-start-end-radius: 50% 3rem;
  }

  .method-inner {
    display: grid;
    gap: var(--space-8);
  }

  .method-visual {
    position: relative;
    inline-size: min(72vw, 24rem);
    justify-self: center;
  }

  .method-image {
    position: relative;
    z-index: 1;
    box-shadow: var(--shadow-float);
  }

  .method-ring {
    inset: 6% -10% -6% 10%;
    border-radius: var(--radius-arch);
  }

  .method-cosmetic {
    inline-size: var(--cosmetic-lg);
    inset-block-end: -12%;
    inset-inline-end: -26%;
  }

  .stages {
    display: grid;
    margin-block-start: var(--space-5);
    border-block-start: 1px solid rgb(74 63 53 / 20%);
  }

  .stage {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-block-end: 1px solid rgb(74 63 53 / 20%);
  }

  .stage-number {
    flex: none;
    inline-size: 2.5rem;
    font-family: var(--type-family-accent);
    font-size: 1.5rem;
    color: var(--color-accent-clay);
  }

  .stage-name {
    font-family: var(--type-family-display);
    font-size: calc(clamp(1.35rem, 1.15rem + 0.8vw, 1.9rem) * var(--type-arabic-size-factor));
    line-height: 1.2;
    color: var(--color-text-primary);
    text-decoration: none;
    transition:
      color var(--motion-duration-base) var(--motion-easing-silk),
      padding var(--motion-duration-base) var(--motion-easing-silk);
  }

  .stage-name:hover {
    color: var(--color-accent-clay-hover);
    padding-inline-start: 0.4rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .boundary-line {
    margin-block-start: var(--space-5);
    max-width: var(--type-measure-editorial);
    font-size: calc(var(--type-body-sm) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-sm) * var(--type-arabic-leading-factor));
    color: var(--color-text-secondary);
  }

  .method-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-block-start: var(--space-4);
  }

  .method-cta :global(.btn) {
    white-space: normal;
    text-align: start;
  }

  /* ================================================================ 5 · recent */

  .all-link .count {
    margin-inline-start: var(--space-1);
    color: var(--color-text-muted);
  }

  .entries {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  /* ================================================================ 6 · meet */

  .meet {
    overflow: clip;
    padding-block: var(--space-8) var(--space-12);
    background: linear-gradient(180deg, var(--palette-ivory), var(--palette-champagne));
  }

  .meet-inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .meet-collage {
    position: relative;
    inline-size: min(80vw, 28rem);
    justify-self: center;
    margin-block-end: var(--space-6);
  }

  .meet-petal {
    inline-size: 70%;
    aspect-ratio: 1;
    inset-block-start: -8%;
    inset-inline-start: -18%;
  }

  .meet-image--main {
    position: relative;
    z-index: 1;
    box-shadow: var(--shadow-float);
  }

  .meet-image--inset {
    position: absolute;
    z-index: 2;
    inline-size: 44%;
    inset-block-end: -12%;
    inset-inline-end: -12%;
    border: 6px solid var(--palette-ivory);
    box-shadow: var(--shadow-float);
  }

  .meet-bio {
    margin-block-start: var(--space-3);
    max-inline-size: 48ch;
    font-size: calc(var(--type-body-lg) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-body-lg) * var(--type-arabic-leading-factor));
    color: var(--color-text-secondary);
  }

  .meet-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-block-start: var(--space-5);
  }

  /* ================================================================ 7 · closing */

  .closing {
    position: relative;
    overflow: clip;
    padding-block: var(--space-12);
    text-align: center;
  }

  .closing-glow {
    inline-size: 50rem;
    block-size: 50rem;
    inset-block-start: -20rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    opacity: 0.4;
  }

  .closing-inner {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
  }

  .closing-quote {
    margin-block-start: var(--space-4);
    max-inline-size: 22ch;
    font-family: var(--type-family-accent);
    font-size: calc(var(--type-display-lg) * var(--type-arabic-size-factor));
    line-height: calc(var(--type-leading-display-lg) * var(--type-arabic-leading-factor));
    color: var(--color-text-primary);
  }

  .closing-sign {
    margin-block-start: var(--space-4);
    font-family: var(--type-family-ui);
    font-size: calc(var(--type-label-sm) * var(--type-arabic-size-factor));
    letter-spacing: var(--type-tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .closing-cosmetic--a {
    inline-size: clamp(8rem, 18vw, 15rem);
    inset-block-end: 6%;
    inset-inline-start: 4%;
  }

  .closing-cosmetic--b {
    inline-size: clamp(6rem, 10vw, 9rem);
    inset-block-start: 18%;
    inset-inline-end: 9%;
  }


  /* ================================================================ PHASE 12 · hero light */

  .opening-leak {
    inline-size: 34rem;
    block-size: 18rem;
    inset-block-start: 26%;
    inset-inline-start: -8rem;
    rotate: -14deg;
  }

  /* The spine label runs down the outer edge of the opening, the way a masthead is set on a
     magazine's fore-edge. Latin only — `.vertical-label` lays itself flat in Arabic. */
  .opening-spine {
    display: none;
  }

  /* ================================================================ 3 · discovery (QUIET) */

  .discovery {
    position: relative;
    overflow: clip;
